# apps/api — every variable this service reads.
# Values are deliberately absent: copy this file to .env.local and fill it in,
# or set each one as a Vercel project environment variable. The six Pusher/Beams
# secrets at the bottom are required in production and have no safe default —
# see docs/realtime.md in apps/accounts for where to mint them.

# ─── Tirbeo API — Environment ───────────────────────────────────────────
# Supabase PostgreSQL (main database)
DATABASE_URL=
DIRECT_DATABASE_URL=
# Supabase public
# Supabase activity/metadata logging (user_activity table).
# Paste your SERVICE_ROLE key here (server-side writes bypass RLS):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# JWT
JWT_SECRET=
UNSUBSCRIBE_SECRET=
SESSION_SECRET=
# API / App URLs
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_COOKIE_DOMAIN=
ADMIN_URL=
# Redis (Upstash)
REDIS_URL=
# Resend (email)
RESEND_API_KEY=
# Cloudflare R2 (media storage)
S3_API_ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# OAuth — GitHub
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# OAuth — Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
# Turnstile (CAPTCHA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Widget CAPTCHA
CAPTCHA_WIDGET_SITE_KEY=
CAPTCHA_WIDGET_SECRET_KEY=
# Twilio (SMS / phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Realtime SFU
REALTIME_SFU_NAME=
REALTIME_SFU_PP_ID=
REALTIME_SFU_API_TOKEN=
# TURN server
TURN_NAME=
TURN_TOKEN_ID=
API_TOKEN=
# WebSocket
NEXT_PUBLIC_WS_URL=
WS_PORT=
# Branding
TIRBEO_LOGO_URL=
# Admin
ADMIN_SEED_EMAIL=
# NODE
NODE_ENV=
# ─── Auth & Security ───
OTP_PEPPER=
RECOVERY_PEPPER=
JWT_ISSUER=
ACCOUNTS_URL=
SECURITY_LOG_KEY=
# ─── Dashboard & Admin URLs ───
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_ADMIN_URL=
# ─── Push Notifications (VAPID) ───
# ─── Turnstile ───
TURNSTILE_SECRET=
# ─── Misc ───
RT_API_TOKEN=
RT_PUBLISH_URL=
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
# PROD VALUES (restore these when deploying / set them in Vercel instead):
# GOOGLE_REDIRECT_URI="https://api.tirbeo.com/api/auth/google/callback"
# GITHUB_REDIRECT_URI="https://api.tirbeo.com/api/auth/github/callback"
# DISCORD_REDIRECT_URI="https://api.tirbeo.com/api/auth/discord/callback"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Outbound mail identity — every sender domain must be verified in Resend.
# Three domains, one job each: the brand's apex for mail a person may answer
# (support@/security@/hello@), a notices subdomain for machine mail (codes,
# digests, staff alerts), and an accounts subdomain for a handle's own mailbox.
ADMIN_FROM_EMAIL=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Alerts for the people who run the panel.
EMAIL_ALERT_FROM=
# One-time codes and verification mail.
EMAIL_CODE_FROM=
# Digests, maintenance notices, product updates.
EMAIL_NOTICE_FROM=
# Warnings about an account: a sign-in, a password, a suspension.
EMAIL_SECURITY_FROM=
# Answers to a person who wrote in.
EMAIL_SUPPORT_FROM=
# Everything else — the brand's own voice.
EMAIL_HELLO_FROM=
# Comma-separated list of the sender domains Resend has VERIFIED. A sender on
# any other domain is rewritten to the fallback rather than earning a 403.
EMAIL_RESEND_DOMAIN=
SUPPORT_EMAIL=
# Domain a handle's identity lives on (username@<this>). Point it at a
# verified subdomain and support mail to staff goes out as that handle.
# Defaults to tirbeo.com when unset.
TIRBEO_MAIL_DOMAIN=
# ─── Self-hosted SMTP delivery (Mailcow) ───
# Set EMAIL_PROVIDER=smtp to send through your own mail server instead of
# Resend. Mailcow pins MAIL FROM to the authenticated mailbox, so EMAIL_FROM
# must equal SMTP_USER or every send is rejected with 553. These are the
# fallbacks — the admin panel's AppConfig 'email.config' row overrides them.
EMAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: explicit TLS SNI name when the SMTP host is behind an IP/alias
# (e.g. mail.tirbeo.app connecting to a differently-named certificate).
SMTP_TLS_SERVERNAME=
# Logo served from the live website (28KB) — api. still hosts the 1MB original until redeploy
# CDN file storage (CockroachDB Dedicated)
COCKROACH_DATABASE_URL=
# ─── Pusher Channels (server-side publishing) ───
# 5 regional apps; publishes fan out to ALL of them in parallel. A client is
# subscribed to exactly one, so a partially configured set silently drops
# events for the clients on the missing app.
#
# The 5 PUSHER_SECRET_* and BEAMS_PRIMARY_KEY values are private signing keys
# and must be set as encrypted Secrets in each hosting environment (Vercel:
# Settings → Environment Variables → "Sensitive"), NOT committed to
# vercel.json. If one is missing, GET /api/health reports
# checks.delivery.status = "degraded" and lists the missing names.
PUSHER_APP_ID_PRIMARY=
PUSHER_KEY_PRIMARY=
PUSHER_SECRET_PRIMARY=
PUSHER_CLUSTER_PRIMARY=
PUSHER_APP_ID_SECONDARY=
PUSHER_KEY_SECONDARY=
PUSHER_SECRET_SECONDARY=
PUSHER_CLUSTER_SECONDARY=
PUSHER_APP_ID_TERTIARY=
PUSHER_KEY_TERTIARY=
PUSHER_SECRET_TERTIARY=
PUSHER_CLUSTER_TERTIARY=
PUSHER_APP_ID_AP2=
PUSHER_KEY_AP2=
PUSHER_SECRET_AP2=
PUSHER_CLUSTER_AP2=
PUSHER_APP_ID_AP4=
PUSHER_KEY_AP4=
PUSHER_SECRET_AP4=
PUSHER_CLUSTER_AP4=
# ─── Pusher Beams (web push) ───
BEAMS_INSTANCE_ID=
BEAMS_PRIMARY_KEY=
# Shared secret for the profile service (apps/myprofile) -> internal/profile
INTERNAL_API_SECRET=
