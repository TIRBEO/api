  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  unblockedAt DateTime? @map("unblocked_at") @db.Timestamptz(6)
  unblockedBy String?   @map("unblocked_by")
  rayId       String    @unique @default(dbgenerated("(gen_random_uuid())::text"))
  metadata    Json?

  @@index([userId])
  @@index([sessionId])
  @@index([ipAddress])
  @@index([rayId])
  @@map("captcha_blocks")
  @@schema("security")
}

model CaptchaLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
