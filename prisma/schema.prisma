model ai_generations {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  task          String // generate | rewrite | translate | subject | digest_summary
  fingerprint   String?  // sha256 of request — cache lookup
  eventKey      String?  @map("event_key")
  model         String
  tone          String?
  instruction   String?
  targetLang    String?  @map("target_lang")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  costEstimate  Float?   @map("cost_estimate")
  status        String   @default("succeeded") // succeeded | failed
  error         String?
  cached        Boolean  @default(false)
  usedCount     Int      @default(0) @map("used_count")
  requestedBy   String?  @map("requested_by")
  resultSubject String?  @map("result_subject")
  resultBlocks  Json?    @map("result_blocks")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([fingerprint], map: "idx_ai_generations_fingerprint")
  @@index([task, createdAt], map: "idx_ai_generations_task_time")
  @@map("ai_generations")
  @@schema("ops")
}

enum session_status {
