  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  definition email_definitions @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, language, version], map: "idx_email_versions_def_lang_ver")
  @@index([definitionId, status], map: "idx_email_versions_def_status")
