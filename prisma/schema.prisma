}

model Bug {
  id               String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId        String      @map("project_id")
  title            String
  description      String?
  category         BugCategory
  severity         BugSeverity @default(P2_MEDIUM)
  priority         Int         @default(0)
  status           BugStatus   @default(NEW)
  reporterId       String      @map("reporter_id")
  assigneeId       String?     @map("assignee_id")
  environment      String?
  browser          String?
  operatingSystem  String?     @map("operating_system")
  device           String?
  url              String?
  expectedResult   String?     @map("expected_result")
  actualResult     String?     @map("actual_result")
  reproductionSteps String?    @map("reproduction_steps")
  rootCause        String?     @map("root_cause")
  proposedFix      String?     @map("proposed_fix")
  businessImpact   String?     @map("business_impact")
  securityImpact   String?     @map("security_impact")
  tags             String[]
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fixedAt          DateTime?   @map("fixed_at") @db.Timestamptz(6)
  closedAt         DateTime?   @map("closed_at") @db.Timestamptz(6)
  reopenedAt       DateTime?   @map("reopened_at") @db.Timestamptz(6)
  project          BugProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter         User        @relation("bug_reporter", fields: [reporterId], references: [id])
  assignee         User?       @relation("bug_assignee", fields: [assigneeId], references: [id])
  comments         BugComment[]
  attachments     BugAttachment[]
  events          BugEvent[]

  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([reporterId])
  @@index([assigneeId])
  @@map("bugs")
}

model BugComment {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  bugId     String   @map("bug_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([bugId])
  @@map("bug_comments")
}

model BugAttachment {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  bugId     String   @map("bug_id")
  filename  String
  url       String
  size      Int?
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@map("bug_attachments")
}

model BugEvent {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  bugId     String   @map("bug_id")
  actorId   String   @map("actor_id")
  action    String
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([bugId])
  @@index([createdAt(sort: Desc)])
  @@map("bug_events")
}
