generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                        String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                                                     String                  @unique
  passwordHash                                              String                  @default("") @map("password_hash")
  name                                                      String?
  photoUrl                                                  String?                 @map("photo_url")
  bio                                                       String?
  secondaryEmail                                            String?                 @map("secondary_email")
  secondaryEmailVerified                                    Boolean?                @default(false) @map("secondary_email_verified")
  phoneNumber                                               String?                 @map("phone_number")
  phoneVerified                                             Boolean?                @default(false) @map("phone_verified")
  emailVerified                                             Boolean?                @default(false) @map("email_verified")
  username                                                  String?                 @unique
  gender                                                    String?
  birthday                                                  DateTime?               @db.Timestamptz(6)
  googleId                                                  String?                 @unique @map("google_id")
  githubId                                                  String?                 @unique @map("github_id")
  discordId                                                 String?                 @unique @map("discord_id")
  occupation                                                String?
  companyName                                               String?                 @map("company_name")
  companyRole                                               String?                 @map("company_role")
  industry                                                  String?
  companySize                                               String?                 @map("company_size")
  website                                                   String?
  linkedin                                                  String?
  githubUsername                                            String?                 @map("github_username")
  twitter                                                   String?
  country                                                   String?
  timezone                                                  String?
  language                                                  String?                 @default("en")
  theme                                                     String?                 @default("system")
  dateFormat                                                String?                 @default("MM/DD/YYYY") @map("date_format")
  timeFormat                                                String?                 @default("12h") @map("time_format")

  preferences                                               Json?                   @default("{}")
  totpSecret                                                String?                 @map("totp_secret")
  is2FAEnabled                                              Boolean?                @default(false) @map("is_2fa_enabled")
  isBanned                                                  Boolean?                @default(false) @map("is_banned")
  isSuspended                                               Boolean?                @default(false) @map("is_suspended")
  suspendReason                                             String?                 @map("suspend_reason")
  suspendedUntil                                            DateTime?               @map("suspended_until") @db.Timestamptz(6)
  adminRole                                                 String?                 @map("admin_role")
  mustChangePassword                                        Boolean?                @default(false) @map("must_change_password")
  lastActiveAt                                              DateTime?               @map("last_active_at") @db.Timestamptz(6)
  lastLoginAt                                               DateTime?               @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp                                               String?                 @map("last_login_ip")
  loginCount                                                Int?                    @default(0) @map("login_count")
  loginHistory        login_history[]
  karmaPoints                                               Int?                    @default(0) @map("karma_points")
  isVerified                                                Boolean?                @default(false) @map("is_verified")
  createdAt                                                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                 DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiKeys                                                   ApiKey[]
  auditEvents                                               AuditEvent[]            @relation("AuditActor")
  blocklist                                                 Blocklist[]
  integrations                                              Integration[]
  media                                                     Media[]
  notificationPreferences                                   NotificationPreference?
  notifications                                             Notification[]
  pushSubscriptions                                         PushSubscription[]
  otps                                                      Otp[]
  recoveryCodes                                             RecoveryCode[]
  securityEvents                                            SecurityEvent[]
  sessions                                                  Session[]
  deviceAccounts                                            deviceAccount[]
  passkeys                                                  Passkey[]

  customerTickets                                           Ticket[]                @relation("TicketCustomer")
  assignedTickets                                           Ticket[]                @relation("TicketAssignee")
  ticketMessages                                            TicketMessage[]         @relation("TicketMessageAuthor")
  apps                                                      apps[]                  @relation("AppOwner")
  userRolesUserRolesAssignedByIdTousers                     UserRole[]              @relation("user_roles_assigned_by_idTousers")
  roles                                                     UserRole[]

  authorizationCodes                                        authorization_codes[]
  accessTokens                                              access_tokens[]
  refreshTokens                                             refresh_tokens[]
  oAuthConsents                                             oAuthConsent[]

  bugProjectsOwned                                          BugProject[]
  bugReports                                                Bug[]                   @relation("bug_reporter")
  bugAssignments                                            Bug[]                   @relation("bug_assignee")
  bugComments                                               BugComment[]
  bugEvents                                                 BugEvent[]

  // Organization & RBAC

  @@index([adminRole], map: "idx_users_admin_role")
  @@index([createdAt], map: "idx_users_created")
  @@index([email], map: "idx_users_email")
  @@index([githubId], map: "idx_users_github_id")
  @@index([googleId], map: "idx_users_google_id")
  @@index([isBanned], map: "idx_users_is_banned")
  @@index([lastActiveAt], map: "idx_users_last_active")
  @@map("users")
}

model UserRole {
  id                                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                            String    @map("user_id")
  roleId                            String    @map("role_id")
  assignedById                      String?   @map("assigned_by_id")
  createdAt                         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usersUserRolesAssignedByIdTousers User?     @relation("user_roles_assigned_by_idTousers", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role                              app_roles @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role")
  @@index([userId], map: "idx_user_roles_user")
  @@map("user_roles")
}

model Session {
  id                       String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                   String          @map("user_id")
  token                    String?
  status                   session_status? @default(active)
  expiresAt                DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime?       @map("last_used_at") @db.Timestamptz(6)
  userAgent                String?         @map("user_agent")
  ipAddress                String?         @map("ip_address")
  location                 String?
  deviceName               String?         @map("device_name")
  revokedAt                DateTime?       @map("revoked_at") @db.Timestamptz(6)
  refreshTokenHash         String?         @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?         @map("previous_refresh_token_hash")
  refreshTokenIssuedAt     DateTime?       @map("refresh_token_issued_at") @db.Timestamptz(6)
  refreshExpiresAt         DateTime?       @map("refresh_expires_at") @db.Timestamptz(6)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_sessions_expires")
  @@index([status], map: "idx_sessions_status")
  @@index([token], map: "idx_sessions_token")
  @@index([userId], map: "idx_sessions_user")
  @@index([refreshTokenHash], map: "idx_sessions_refresh_token")
  @@index([refreshExpiresAt], map: "idx_sessions_refresh_expires")
  @@map("sessions")
}

/// Accounts remembered on a specific device for one-tap account switching.
model deviceAccount {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  deviceId   String    @map("device_id")
  userId     String    @map("user_id")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([deviceId, userId], map: "idx_device_accounts_device_user")
  @@index([userId], map: "idx_device_accounts_user")
  @@map("device_accounts")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String    @map("user_id")
  code      String
  used      Boolean?  @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code], map: "idx_recovery_codes_code")
  @@index([userId], map: "idx_recovery_codes_user")
  @@map("recovery_codes")
}

model Media {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  uploadedBy String   @map("uploaded_by")
  url        String
  filename   String?
  mimeType   String?  @map("mime_type")
  sizeBytes  BigInt?  @map("size_bytes")
  width      Int?
  height     Int?
  duration   Float?
  altText    String?  @map("alt_text")
  isPublic   Boolean? @default(true) @map("is_public")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mimeType], map: "idx_media_mime")
  @@index([isPublic], map: "idx_media_public")
  @@index([uploadedBy], map: "idx_media_uploader")
  @@map("media")
}

model SecurityEvent {
  id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?         @map("user_id")
  eventType String          @map("event_type")
  severity  severity_level? @default(info)
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  metadata  Json?           @default("{}")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt], map: "idx_security_events_created")
  @@index([eventType], map: "idx_security_events_type")
  @@index([userId], map: "idx_security_events_user")
  @@map("security_events")
}

model AuditEvent {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId    String?         @map("actor_id")
  action     String
  targetType String?         @map("target_type")
  targetId   String?         @map("target_id")
  metadata   Json?           @default("{}")
  severity   severity_level? @default(info)
  ipAddress  String?         @map("ip_address")
  userAgent  String?         @map("user_agent")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
   actor      User?           @relation("AuditActor", fields: [actorId], references: [id], onUpdate: NoAction)

   @@index([action], map: "idx_audit_events_action")
   @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_events_actor_created")
   @@index([actorId], map: "idx_audit_events_actor")
   @@map("audit_events")
}

model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  icon      String?
  link      String?
  isRead    Boolean? @default(false) @map("is_read")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_notifications_created")
  @@index([isRead], map: "idx_notifications_read")
  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @unique @map("user_id")
  type      String   @default("all")
  // Global channel toggles
  email     Boolean? @default(true)
  push      Boolean? @default(true)
  inApp     Boolean? @default(true) @map("in_app")
  // Category toggles
  security  Boolean? @default(true)
  forms     Boolean? @default(true)
  product   Boolean? @default(true)
  support   Boolean? @default(true)
  // Per-category x channel matrix
  securityEmail   Boolean? @default(true) @map("security_email")
  securityPush    Boolean? @default(true) @map("security_push")
  securityInApp   Boolean? @default(true) @map("security_in_app")
  formsEmail      Boolean? @default(true) @map("forms_email")
  formsPush       Boolean? @default(true) @map("forms_push")
  formsInApp      Boolean? @default(true) @map("forms_in_app")
  productEmail    Boolean? @default(true) @map("product_email")
  productPush     Boolean? @default(true) @map("product_push")
  productInApp    Boolean? @default(true) @map("product_in_app")
  supportEmail    Boolean? @default(true) @map("support_email")
  supportPush     Boolean? @default(true) @map("support_push")
  supportInApp    Boolean? @default(true) @map("support_in_app")
  // Quiet hours
  quietHoursEnabled  Boolean? @default(false) @map("quiet_hours_enabled")
  quietHoursStart    String?  @default("22:00") @map("quiet_hours_start")
  quietHoursEnd      String?  @default("08:00") @map("quiet_hours_end")
  // Email digest
  digestEnabled   Boolean?  @default(false) @map("digest_enabled")
  digestFrequency String?   @default("daily") @map("digest_frequency")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notification_preferences")
}

model PushSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id")
  endpoint   String
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, endpoint], map: "push_subscriptions_user_id_endpoint_key")
  @@index([userId], map: "idx_push_subscriptions_user_id")
  @@map("push_subscriptions")
}

model ApiKey {
  id           String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String           @map("user_id")
  name         String
  keyHash      String           @unique @map("key_hash")
  keyPrefix    String           @map("key_prefix")
  permissions  Json?            @default("{}")
  isActive     Boolean?         @default(true) @map("is_active")
  lastUsedAt   DateTime?        @map("last_used_at") @db.Timestamptz(6)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([keyHash], map: "idx_api_keys_hash")
  @@index([keyPrefix], map: "idx_api_keys_prefix")
  @@index([userId], map: "idx_api_keys_user")
  @@map("api_keys")
}

model Setting {
  id               String              @id @default(uuid())
  key              String              @unique
  value            Json
  type             String              @default("string")
  group            String              @default("general")
  label            String?
  description      String?
  isSecret         Boolean             @default(false) @map("is_secret")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([key])
  @@index([group])
  @@map("settings")
}

model SiteConfig {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  app       String   @unique
  config    Json     @default("{}")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([app], map: "idx_site_configs_app")
  @@map("site_configs")
}

model ThemeConfig {
  id                 String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name               String   @unique
  isActive           Boolean? @default(false) @map("is_active")
  isDefault          Boolean? @default(false) @map("is_default")
  bgPrimary          String?  @default("#08150F") @map("bg_primary")
  bgSecondary        String?  @default("#101c13") @map("bg_secondary")
  bgCard             String?  @default("#12271D") @map("bg_card")
  bgElevated         String?  @default("#1a3326") @map("bg_elevated")
  textPrimary        String?  @default("#F2EEE8") @map("text_primary")
  textSecondary      String?  @default("#B7C6BE") @map("text_secondary")
  textMuted          String?  @default("#6b8a7a") @map("text_muted")
  accentPrimary      String?  @default("#569578") @map("accent_primary")
  accentSecondary    String?  @default("#275d46") @map("accent_secondary")
  accentHover        String?  @default("#6aab8d") @map("accent_hover")
  success            String?  @default("#59C173")
  warning            String?  @default("#F4B942")
  error              String?  @default("#E45D5D")
  borderColor        String?  @default("rgba(255,255,255,0.08)") @map("border_color")
  borderHover        String?  @default("rgba(255,255,255,0.14)") @map("border_hover")
  borderRadius       String?  @default("16px") @map("border_radius")
  fontPrimary        String?  @default("Inter") @map("font_primary")
  fontHeading        String?  @default("Plus Jakarta Sans") @map("font_heading")
  logoUrl            String?  @map("logo_url")
  brandName          String?  @default("Tirbeo") @map("brand_name")
  brandTagline       String?  @default("Premium Social Platform") @map("brand_tagline")
  lightBgPrimary     String?  @map("light_bg_primary")
  lightBgSecondary   String?  @map("light_bg_secondary")
  lightTextPrimary   String?  @map("light_text_primary")
  lightAccentPrimary String?  @map("light_accent_primary")
  emailHeaderBg      String?  @default("linear-gradient(135deg,#022B22,#275D46,#569578)") @map("email_header_bg")
  emailButtonColor   String?  @default("#569578") @map("email_button_color")
  emailTextColor     String?  @default("#B7C6BE") @map("email_text_color")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_theme_configs_active")
  @@map("theme_configs")
}

model FeatureFlag {
  id               String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  key              String                 @unique
  name             String
  description      String?
  isActive         Boolean?               @default(false) @map("is_active")
  rolloutPct       Int?                   @default(100) @map("rollout_pct")
  metadata         Json?                  @default("{}")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_feature_flags_active")
  @@index([key], map: "idx_feature_flags_key")
  @@map("feature_flags")
}

model HelpArticle {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug      String   @unique
  title     String
  content   String
  category  String
  icon      String
  ord       Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([slug])
  @@index([published])
  @@index([ord])
  @@map("help_articles")
}

model Ticket {
  id                String               @id @default(uuid())
  customerId        String               @map("customer_id")
  subject           String
  description       String?
  category          String               @default("general")
  priority          String               @default("normal")
  status            String               @default("open")
  source            String               @default("web")
  application       String?
  queueId           String?              @map("queue_id")
  assignedId        String?              @map("assigned_id")
  slaId             String?              @map("sla_id")
  closedAt          DateTime?            @map("closed_at")
  attachments         ticket_attachments[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  ticketAssignments ticket_assignments[]
  messages          TicketMessage[]
  queue             support_queues?      @relation(fields: [queueId], references: [id])
  customer          User                 @relation("TicketCustomer", fields: [customerId], references: [id])
  assigned          User?                @relation("TicketAssignee", fields: [assignedId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([assignedId])
  @@index([createdAt])
  @@index([priority])
  @@index([queueId])
  @@map("tickets")
}

model TicketMessage {
  id         String    @id @default(uuid())
  ticketId   String    @map("ticket_id")
  authorId   String    @map("author_id")
  content    String
  isInternal Boolean   @default(false) @map("is_internal")
  readAt     DateTime? @map("read_at")
  readBy     String?   @map("read_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User      @relation("TicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

model Blocklist {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String?
  blockedBy  String?   @map("blocked_by")
  isActive   Boolean?  @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users      User?     @relation(fields: [blockedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([targetType, targetId])
  @@index([isActive], map: "idx_blocklist_active")
  @@index([targetType], map: "idx_blocklist_type")
  @@map("blocklist")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model app_oauth_clients {
  id                 String                @id @default(dbgenerated("(gen_random_uuid())"))
  appId              String                @map("app_id")
  clientId           String                @unique @map("client_id")
  clientSecret       String?               @map("client_secret")
  redirectUris       Json                  @default("[]") @map("redirect_uris")
  grants             Json                  @default("[]")
  scopes             Json                  @default("[]")
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @map("updated_at")
  apps               apps                  @relation(fields: [appId], references: [id], onDelete: Cascade)
  authorizationCodes authorization_codes[]
  accessTokens       access_tokens[]
  refreshTokens      refresh_tokens[]
  oAuthConsents      oAuthConsent[]

  @@index([appId])
  @@index([clientId])
}

model authorization_codes {
  id                  String            @id @default(dbgenerated("(gen_random_uuid())"))
  clientId            String            @map("client_id")
  userId              String            @map("user_id")
  code                String            @unique
  redirectUri         String            @map("redirect_uri")
  scopes              Json
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(6)
  usedAt              DateTime?         @map("used_at") @db.Timestamptz(6)
  codeChallenge       String?           @map("code_challenge")
  codeChallengeMethod String?           @map("code_challenge_method")
