generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════════
// CORE USER & AUTH
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id                          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                       String    @unique
  passwordHash                String    @default("") @map("password_hash")
  name                        String?
  photoUrl                    String?   @map("photo_url")
  bio                         String?
  secondaryEmail              String?   @map("secondary_email")
  secondaryEmailVerified      Boolean?  @default(false) @map("secondary_email_verified")
  phoneNumber                 String?   @map("phone_number")
  phoneVerified               Boolean?  @default(false) @map("phone_verified")
  emailVerified               Boolean?  @default(false) @map("email_verified")
  username                    String?   @unique
  gender                      String?
  birthday                    DateTime? @db.Timestamptz(6)

  // OAuth IDs (provider tokens stored here instead of separate integrations table)
  googleId                    String?   @unique @map("google_id")
  githubId                    String?   @unique @map("github_id")
  discordId                   String?   @unique @map("discord_id")

  occupation                  String?
  companyName                 String?   @map("company_name")
  companyRole                 String?   @map("company_role")
  industry                    String?
  companySize                 String?   @map("company_size")
  website                     String?
  linkedin                    String?
  githubUsername              String?   @map("github_username")
  twitter                     String?
  country                     String?
  timezone                    String?
  language                    String?   @default("en")
  theme                       String?   @default("system")
  dateFormat                  String?   @default("MM/DD/YYYY") @map("date_format")
  timeFormat                  String?   @default("12h") @map("time_format")

  consents                    Json?     @default("{}")

  // Security
  totpSecret                  String?   @map("totp_secret")
  is2FAEnabled                Boolean?  @default(false) @map("is_2fa_enabled")
  backupCodes                 Json?     @default("[]") // [{code, used}]
  isBanned                    Boolean?  @default(false) @map("is_banned")
  isSuspended                 Boolean?  @default(false) @map("is_suspended")
  suspendReason               String?   @map("suspend_reason")
  suspendedUntil              DateTime? @map("suspended_until") @db.Timestamptz(6)
  mustChangePassword          Boolean?  @default(false) @map("must_change_password")
  lastActiveAt                DateTime? @map("last_active_at") @db.Timestamptz(6)
  lastLoginAt                 DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp                 String?   @map("last_login_ip")

  // Soft-delete
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz(6)
  scheduledDeletionAt         DateTime? @map("scheduled_deletion_at") @db.Timestamptz(6)
  deletionReason              String?   @map("deletion_reason")

  adminRole                   String?   @map("admin_role")

  // Notifications (merged from old notification_preferences table)
  notifEmail                  Boolean?  @default(true) @map("notif_email")
  notifPush                   Boolean?  @default(true) @map("notif_push")
  notifInApp                  Boolean?  @default(true) @map("notif_in_app")
  notifSecurity               Boolean?  @default(true) @map("notif_security")
  notifForms                  Boolean?  @default(true) @map("notif_forms")
  notifProduct                Boolean?  @default(true) @map("notif_product")
  notifSupport                Boolean?  @default(true) @map("notif_support")
  notifQuietHoursEnabled      Boolean?  @default(false) @map("notif_quiet_hours_enabled")
  notifQuietHoursStart        String?   @default("22:00") @map("notif_quiet_hours_start")
  notifQuietHoursEnd          String?   @default("08:00") @map("notif_quiet_hours_end")
  notifDigestEnabled          Boolean?  @default(false) @map("notif_digest_enabled")
  notifDigestFrequency        String?   @default("daily") @map("notif_digest_frequency")
  notificationPreferences     Json?     @default("{}") @map("notification_preferences")

  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  loginHistory                login_history[]
  apiKeys                     ApiKey[]
  auditEvents                 AuditEvent[]     @relation("AuditActor")
  blocklist                   Blocklist[]
  media                       Media[]
  notifications               Notification[]
  otps                        Otp[]
  securityEvents              SecurityEvent[]
  sessions                    Session[]
  deviceAccounts              deviceAccount[]
  passkeys                    Passkey[]
  tipLogs                     UserTipLog[]
  integrations                Integration[]

  customerTickets             Ticket[]          @relation("TicketCustomer")
  assignedTickets             Ticket[]          @relation("TicketAssignee")
  ticketMessages              TicketMessage[]   @relation("TicketMessageAuthor")
  forms                       Form[]
  apps                        apps[]        @relation("AppOwner")

  @@index([adminRole], map: "idx_users_admin_role")
  @@index([createdAt], map: "idx_users_created")
  @@index([email], map: "idx_users_email")
  @@index([githubId], map: "idx_users_github_id")
  @@index([googleId], map: "idx_users_google_id")
  @@index([isBanned], map: "idx_users_is_banned")
  @@index([lastActiveAt], map: "idx_users_last_active")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@index([scheduledDeletionAt], map: "idx_users_scheduled_deletion")
  @@map("users")
}

model Session {
  id                       String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                   String          @map("user_id")
  token                    String?
  status                   session_status? @default(active)
  expiresAt                DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime?       @map("last_used_at") @db.Timestamptz(6)
  userAgent                String?         @map("user_agent")
  ipAddress                String?         @map("ip_address")
  location                 String?
  deviceName               String?         @map("device_name")
  revokedAt                DateTime?       @map("revoked_at") @db.Timestamptz(6)
  refreshTokenHash         String?         @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?         @map("previous_refresh_token_hash")
  refreshTokenIssuedAt     DateTime?       @map("refresh_token_issued_at") @db.Timestamptz(6)
  refreshExpiresAt         DateTime?       @map("refresh_expires_at") @db.Timestamptz(6)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_sessions_expires")
  @@index([status], map: "idx_sessions_status")
  @@index([token], map: "idx_sessions_token")
  @@index([userId], map: "idx_sessions_user")
  @@index([refreshTokenHash], map: "idx_sessions_refresh_token")
  @@index([refreshExpiresAt], map: "idx_sessions_refresh_expires")
  @@map("sessions")
}

model deviceAccount {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  deviceId   String    @map("device_id")
  userId     String    @map("user_id")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([deviceId, userId], map: "idx_device_accounts_device_user")
  @@index([userId], map: "idx_device_accounts_user")
  @@map("device_accounts")
}

model Otp {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  type      String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int?     @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_otps_expires")
  @@index([type], map: "idx_otps_type")
  @@index([userId], map: "idx_otps_user")
  @@map("otps")
}

model SignupOtp {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int?     @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email], map: "idx_signup_otps_email")
  @@index([expiresAt], map: "idx_signup_otps_expires")
  @@map("signup_otps")
}

model ApiKey {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String    @map("user_id")
  name       String
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  permissions Json?   @default("{}")
  isActive   Boolean?  @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([keyHash], map: "idx_api_keys_hash")
  @@index([keyPrefix], map: "idx_api_keys_prefix")
  @@index([userId], map: "idx_api_keys_user")
  @@map("api_keys")
}

model Passkey {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId              String   @map("user_id")
  credentialId        String   @unique @map("credential_id")
  credentialPublicKey Bytes    @map("credential_public_key")
  counter             BigInt   @default(0)
  transports          String?
  deviceName          String?  @map("device_name")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([userId])
  @@map("passkeys")
}

model UserTipLog {
  id     String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId String   @map("user_id")
  tipId  String   @map("tip_id")
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, tipId])
  @@index([userId], map: "idx_tip_logs_user")
  @@map("user_tip_logs")
}

model Blocklist {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String?
  blockedBy  String?   @map("blocked_by")
  isActive   Boolean?  @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users      User?     @relation(fields: [blockedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([targetType, targetId])
  @@index([isActive], map: "idx_blocklist_active")
  @@index([targetType], map: "idx_blocklist_type")
  @@map("blocklist")
}

// ═══════════════════════════════════════════════════════════════════════════════
// EVENTS & SECURITY
// ═══════════════════════════════════════════════════════════════════════════════

model SecurityEvent {
  id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?         @map("user_id")
  eventType String          @map("event_type")
  severity  severity_level? @default(info)
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  metadata  Json?           @default("{}")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt], map: "idx_security_events_created")
  @@index([eventType], map: "idx_security_events_type")
  @@index([userId], map: "idx_security_events_user")
  @@map("security_events")
}

model AuditEvent {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId    String?         @map("actor_id")
  action     String
  targetType String?         @map("target_type")
  targetId   String?         @map("target_id")
  metadata   Json?           @default("{}")
  severity   severity_level? @default(info)
  ipAddress  String?         @map("ip_address")
  userAgent  String?         @map("user_agent")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?           @relation("AuditActor", fields: [actorId], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_audit_events_action")
  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_events_actor_created")
  @@index([actorId], map: "idx_audit_events_actor")
  @@map("audit_events")
}

model login_history {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  email     String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  success   Boolean  @default(true)
  method    String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("login_history")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  icon      String?
  link      String?
  isRead    Boolean? @default(false) @map("is_read")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_notifications_created")
  @@index([isRead], map: "idx_notifications_read")
  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MEDIA
// ═══════════════════════════════════════════════════════════════════════════════

model Media {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  uploadedBy String   @map("uploaded_by")
  url        String
  filename   String?
  mimeType   String?  @map("mime_type")
  sizeBytes  BigInt?  @map("size_bytes")
  width      Int?
  height     Int?
  duration   Float?
  altText    String?  @map("alt_text")
  isPublic   Boolean? @default(true) @map("is_public")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mimeType], map: "idx_media_mime")
  @@index([isPublic], map: "idx_media_public")
  @@index([uploadedBy], map: "idx_media_uploader")
  @@map("media")
}

// ═══════════════════════════════════════════════════════════════════════════════
// EMAIL SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

model emailConfig {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  provider         String   @default("resend")
  resendApiKey     String?
  resendDomain     String?  @default("send.tirbeo.app")
  smtpHost         String?
  smtpPort         Int?     @default(587)
  smtpUser         String?
  smtpPass         String?
  defaultFromEmail String   @default("noreply@send.tirbeo.app")
  defaultFromName  String   @default("Tirbeo")
  welcomeFromEmail String?
  welcomeFromName  String?
  otpFromEmail     String?
  otpFromName      String?
  resetFromEmail   String?
  resetFromName    String?
  notifyFromEmail  String?
  notifyFromName   String?
  alertFromEmail   String?
  alertFromName    String?
  formsFromEmail   String?  @default("forms@send.tirbeo.app")
  formsFromName    String?  @default("Tirbeo Forms")
  customDomain     String?
  dkimEnabled      Boolean  @default(false)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@map("email_configs")
}

model emailTemplate {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String   @unique
  label     String?
  subject   String
  htmlBody  String
  variables Json?    @default("[]")
  fromEmail String?
  fromName  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("email_templates")
}

model email_logs {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  toEmail   String    @map("to_email")
  fromEmail String?   @map("from_email")
  subject   String
  template  String?
  status    String?   @default("sent")
  threadId  String?   @map("thread_id")
  replyTo   String?   @map("reply_to")
  openedAt  DateTime? @map("opened_at") @db.Timestamptz(6)
  clickedAt DateTime? @map("clicked_at") @db.Timestamptz(6)
  error     String?
  metadata  Json?     @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_email_logs_created")
  @@index([status], map: "idx_email_logs_status")
  @@index([threadId], map: "idx_email_logs_thread")
  @@index([toEmail], map: "idx_email_logs_to")
  @@map("email_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CAPTCHA (Rate Limiting / Bot Protection)
// ═══════════════════════════════════════════════════════════════════════════════

model CaptchaChallenge {
  id            String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId     String          @map("session_id")
  userId        String?         @map("user_id")
  difficulty    String          @default("easy")
  challengeType String          @default("image")
  question      String
  answerHash    String          @map("answer_hash")
  options       Json?
  imageUrl      String?         @map("image_url")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(6)
  attempts      Int             @default(0)
  solved        Boolean         @default(false)
  solvedAt      DateTime?       @map("solved_at") @db.Timestamptz(6)
  ipAddress     String?         @map("ip_address")
  userAgent     String?         @map("user_agent")
  rayId         String          @unique @default(dbgenerated("(gen_random_uuid())::text"))
  attemptLogs   CaptchaAttempt[]

  @@index([sessionId])
  @@index([userId])
  @@index([rayId])
  @@index([difficulty])
  @@map("captcha_challenges")
}

model CaptchaAttempt {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  challengeId String   @map("challenge_id")
  userId      String?  @map("user_id")
  sessionId   String   @map("session_id")
  answer      String
  isCorrect   Boolean  @default(false) @map("is_correct")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge CaptchaChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([sessionId])
  @@map("captcha_attempts")
}

model CaptchaBlock {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?   @map("user_id")
  sessionId   String    @map("session_id")
  ipAddress   String    @map("ip_address")
  reason      String
  difficulty  String    @default("hard")
  blockedAt   DateTime  @default(now()) @map("blocked_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  unblockedAt DateTime? @map("unblocked_at") @db.Timestamptz(6)
  unblockedBy String?   @map("unblocked_by")
  rayId       String    @unique @default(dbgenerated("(gen_random_uuid())::text"))
  metadata    Json?

  @@index([userId])
  @@index([sessionId])
  @@index([ipAddress])
  @@index([rayId])
  @@map("captcha_blocks")
}

model CaptchaLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String?  @map("user_id")
  sessionId  String   @map("session_id")
  ipAddress  String   @map("ip_address")
  eventType  String   @map("event_type")
  difficulty String?
  rayId      String?  @map("ray_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([sessionId])
  @@index([ipAddress])
  @@index([eventType])
  @@index([rayId])
  @@map("captcha_logs")
}

model CaptchaSettings {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  key         String   @unique
  value       Json
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("captcha_settings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INCIDENTS & CRASH TRACKING
// ═══════════════════════════════════════════════════════════════════════════════

model incidents {
  id           String            @id @default(dbgenerated("(gen_random_uuid())"))
  title        String
  description  String?
  severity     String            @default("minor")
  status       String            @default("investigating")
  services     Json              @default("[]")
  applications Json              @default("[]")
  ownerId      String?           @map("owner_id")
  resolvedAt   DateTime?         @map("resolved_at")
  postmortem   String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at")
  events       incident_events[]

  @@index([severity])
  @@index([status])
}

model incident_events {
  id         String     @id @default(uuid())
  incidentId String     @map("incident_id")
  type       String
  message    String?
  userId     String?    @map("user_id")
  metadata   Json?      @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  incident   incidents  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([userId])
  @@map("incident_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FORMS (Core Product)
// ═══════════════════════════════════════════════════════════════════════════════

model Form {
  id                String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String          @map("user_id")
  name              String
  slug              String          @unique
  description       String?
  status            String          @default("draft")
  accessKey         String          @unique @map("access_key") @default("")
  formType          String          @default("custom") @map("form_type")
  websiteUrl        String?         @map("website_url")

  successMessage    String?         @default("Thanks! Your submission has been received.") @map("success_message")
  successRedirect   String?         @map("success_redirect")
  redirectTarget    String          @default("_self") @map("redirect_target")
  customSuccessHtml String?         @map("custom_success_html")

  notificationEmails String[]       @map("notification_emails")
  ccEmails          String[]        @map("cc_emails")
  bccEmails         String[]        @map("bcc_emails")
  replyToEmail      String?         @map("reply_to_email")
  emailSubject      String?         @map("email_subject")
  fromName          String?         @map("from_name")

  autoReply         Boolean         @default(false) @map("auto_reply")
  autoReplySubject  String?         @map("auto_reply_subject")
  autoReplyBody     String?         @map("auto_reply_body")

  spamProtection    String          @default("automatic") @map("spam_protection")
  turnstileKey      String?         @map("turnstile_key")
  rateLimit         Int             @default(60) @map("rate_limit")
  allowedOrigins    String[]        @map("allowed_origins")
  honeypot          Boolean         @default(true)

  storeResponses    Boolean         @default(true) @map("store_responses")
  retention         String          @default("forever")
  showMetadata      Boolean         @default(false) @map("show_metadata")

  layout            String          @default("comfortable")
  width             String          @default("full")
  alignment         String          @default("left")
  labelPosition     String          @default("above") @map("label_position")
  theme             String          @default("light")
  customCss         String?         @map("custom_css")
  headless          Boolean         @default(false)

  headerImage       String?         @map("header_image")
  accentColor       String          @default("#09090b") @map("accent_color")
  bgColor           String          @default("#ffffff") @map("bg_color")
  headerFont        String          @default("Roboto") @map("header_font")
  questionFont      String          @default("Roboto") @map("question_font")
  headerImageHeight Int             @default(200) @map("header_image_height")

  submissionCount   Int             @default(0) @map("submission_count")
  lastSubmissionAt  DateTime?       @map("last_submission_at") @db.Timestamptz(6)
  conversionRate    Float           @default(0) @map("conversion_rate")

  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields            FormField[]
  submissions       FormSubmission[]
  analytics         FormAnalytic[]
  connections       FormConnection[]

  @@index([userId])
  @@index([status])
  @@index([slug])
  @@map("forms")
}

model FormField {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  formId        String   @map("form_id")
  label         String
  name          String
  type          String   @default("text")
  required      Boolean  @default(false)
  placeholder   String?
  helpText      String?  @map("help_text")
  defaultValue  Json?    @map("default_value")
  options       Json?
  validation    Json?
  appearance    Json?
  order         Int      @default(0)
  hidden        Boolean  @default(false)
  readOnly      Boolean  @default(false) @map("read_only")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  form          Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormSubmission {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  formId        String   @map("form_id")
  data          Json     @default("{}")
  metadata      Json?
  source        String?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  referrer      String?  @map("referrer")
  country       String?
  status        String   @default("new")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  form          Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([createdAt])
  @@index([formId, createdAt])
  @@map("form_submissions")
}

model FormAnalytic {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  formId            String   @map("form_id")
  date              DateTime @db.Date
  views             Int      @default(0)
  starts            Int      @default(0)
  submissions       Int      @default(0)
  failedSubmissions Int      @default(0) @map("failed_submissions")
  avgCompletionTime Float?   @map("avg_completion_time")
  deviceBreakdown   Json?    @map("device_breakdown")
  countryBreakdown  Json?    @map("country_breakdown")
  referrerBreakdown Json?    @map("referrer_breakdown")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  form              Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, date])
  @@index([formId])
  @@map("form_analytics")
}

model FormConnection {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  formId        String   @map("form_id")
  type          String
  name          String
  config        Json     @default("{}")
  isActive      Boolean  @default(true) @map("is_active")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  form          Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_connections")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SUPPORT TICKETS
// ═══════════════════════════════════════════════════════════════════════════════

model Ticket {
  id          String          @id @default(uuid())
  customerId  String          @map("customer_id")
  subject     String
  description String?
  category    String          @default("general")
  priority    String          @default("normal")
  status      String          @default("open")
  source      String          @default("web")
  application String?
  assignedId  String?         @map("assigned_id")
  closedAt    DateTime?       @map("closed_at")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at")

  attachments ticket_attachments[]
  messages    TicketMessage[]
  customer    User            @relation("TicketCustomer", fields: [customerId], references: [id])
  assigned    User?           @relation("TicketAssignee", fields: [assignedId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([assignedId])
  @@index([createdAt])
  @@index([priority])
  @@map("tickets")
}

model TicketMessage {
  id         String    @id @default(uuid())
  ticketId   String    @map("ticket_id")
  authorId   String    @map("author_id")
  content    String
  isInternal Boolean   @default(false) @map("is_internal")
  readAt     DateTime? @map("read_at")
  readBy     String?   @map("read_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User      @relation("TicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

model ticket_attachments {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  ticketId  String   @map("ticket_id")
  messageId String?  @map("message_id")
  fileName  String   @map("file_name")
  fileUrl   String   @map("file_url")
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// APPS PLATFORM
// ═══════════════════════════════════════════════════════════════════════════════

model apps {
  id          String   @id @default(dbgenerated("(gen_random_uuid())"))
  name        String
  slug        String   @unique
  description String?
  icon        String?
  url         String?
  status      String   @default("active")
  isPublic    Boolean  @default(true) @map("is_public")
  ownerId     String   @map("owner_id")
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation("AppOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([slug])
}

// ═══════════════════════════════════════════════════════════════════════════════
// INTEGRATIONS (OAuth Provider Connections)
// ═══════════════════════════════════════════════════════════════════════════════

model Integration {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String    @map("user_id")
  provider     String
  connected    Boolean?  @default(false)
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  metadata     Json?     @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, provider])
  @@index([userId], map: "idx_integrations_user")
  @@map("integrations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum session_status {
  active
  expired
  revoked
}

enum severity_level {
  info
  warning
  error
  critical
}
