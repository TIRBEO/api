generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  schemas = ["user", "preferences", "email", "security", "status", "activity", "ops"]
}

// ═══ The account ═══════════════════════════════════════════════════

enum UserStatusKind {
  active
  restricted
  suspended
  deactivated
  deletion_pending
  deleted

  @@map("user_status_kind")
  @@schema("user")
}

model User {
  id           String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  username     String?        @unique
  email        String         @unique
  passwordHash String         @default("") @map("password_hash")
  name         String?
  photoUrl     String?        @map("photo_url")
  status       UserStatusKind @default(active)
  isAdmin      Boolean        @default(false) @map("is_admin")
  adminRole    String?        @map("admin_role")

  emailVerified Boolean?      @default(false) @map("email_verified")
  phoneVerified Boolean?      @default(false) @map("phone_verified")

  googleId     String?        @unique @map("google_id")
  githubId     String?        @unique @map("github_id")
  discordId    String?        @unique @map("discord_id")

  theme        String?        @default("system")
  language     String?        @default("en")
  timezone     String?
  consents     Json?          @default("{}")
  notificationPreferences Json? @default("{\"email\":true,\"push\":true,\"security\":true,\"forms\":true,\"product\":false,\"support\":true,\"formsEmail\":true,\"formsPush\":true,\"productEmail\":false,\"productPush\":true,\"supportEmail\":true,\"supportPush\":true,\"digestEnabled\":false,\"digestFrequency\":\"daily\"}") @map("notification_preferences")
  emailUnsubscribed Json?     @default("{}") @map("email_unsubscribed")

  totpSecret   String?        @map("totp_secret")
  is2FAEnabled Boolean?       @default(false) @map("is_2fa_enabled")
  backupCodes  Json?          @default("[]")
  mustChangePassword Boolean? @default(false) @map("must_change_password")

  isBanned        Boolean?    @default(false) @map("is_banned")
  isSuspended     Boolean?    @default(false) @map("is_suspended")
  suspendReason   String?     @map("suspend_reason")
  suspendedUntil  DateTime?   @map("suspended_until") @db.Timestamptz(6)
  banRefCode      String?     @map("ban_ref_code")
  suspendRefCode  String?     @map("suspend_ref_code")
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)
  scheduledDeletionAt DateTime? @map("scheduled_deletion_at") @db.Timestamptz(6)
  deletionReason String? @map("deletion_reason")
  lastActiveAt    DateTime?   @map("last_active_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile         UserProfile?
  preferences     UserPreferences?
  emails          UserEmail[]
  phone           UserPhone?
  security        UserSecurity?
  passkeys        Passkey[]
  sessions        UserSession[]
  devices         UserDevice[]
  statusEvents    UserStatusEvent[]
  deactivation    UserDeactivation?
  deletionRequest UserDeletionRequest?
  restrictions    UserRestriction[]
  appeals         UserAppeal[]
  activityEvents  ActivityEvent[]
  dataExportRequests DataExportRequest[]
  notifications   Notification[]
  logins          UserLogin[]
  emailJobs       email_jobs[]
  otps            Otp[]
  apiKeys         ApiKey[]
  blockedRecords  Blocklist[]
  securityEvents     SecurityEvent[]
  deviceAccounts     deviceAccount[]
  tipLogs            UserTipLog[]
  pushSubscriptions  PushSubscription[]
  tirbeoIdentities   TirbeoIdentity[]

  @@index([status], map: "idx_users_status")
  @@index([createdAt], map: "idx_users_created")
  @@index([lastActiveAt], map: "idx_users_last_active")
  @@index([deletedAt], map: "idx_users_deleted")
  @@map("users")
  @@schema("user")
}

// ═══ user.profile ══════════════════════════════════════════════════

model UserProfile {
  userId     String   @id @map("user_id")
  name       String?
  bio        String?
  gender     String?
  birthday   DateTime? @db.Date
  photoUrl   String?  @map("photo_url")
  bannerUrl  String?  @map("banner_url")
  pronouns   String?
  location   String?
  website    String?
  jobRole    String?  @map("job_role")
  jobCompany String?  @map("job_company")
  jobPlace   String?  @map("job_place")
  jobStarted String?  @map("job_started")
  skills     Json     @default("[]")
  followers  Int      @default(0)
  following  Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
  @@schema("user")
}

// ═══ user.preferences ══════════════════════════════════════════════

model UserPreferences {
  userId     String   @id @map("user_id")
  appearance Json     @default("{}")
  notif      Json     @default("{}")
  privacy    Json     @default("{}")
  misc       Json     @default("{}")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("preferences")
}

// ═══ user.email ════════════════════════════════════════════════════

model UserEmail {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String    @map("user_id")
  address    String
  kind       String    @default("primary") // primary | secondary | recovery
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId], map: "idx_user_email_user")
  @@map("user_email")
  @@schema("email")
}

model UserPhone {
  userId     String    @id @map("user_id")
  number     String?
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_phone")
  @@schema("user")
}

// ═══ user.security ═════════════════════════════════════════════════

model UserSecurity {
  userId       String   @id @map("user_id")
  totpSecret   String?  @map("totp_secret")
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  backupCodes  Json     @default("[]") @map("backup_codes")
  mustChangePw Boolean  @default(false) @map("must_change_pw")
  saveLoginInfo Boolean @default(true) @map("save_login_info")
  require2FA   Boolean  @default(false) @map("require_2fa")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_security")
  @@schema("security")
}

model Passkey {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String    @map("user_id")
  credentialId   String    @unique @map("credential_id")
  credentialPubkey Bytes   @map("credential_pubkey")
  counter        BigInt    @default(0)
  transports     String?
  deviceName     String?   @map("device_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_passkeys_user")
  @@map("passkeys")
  @@schema("security")
}

model UserSession {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  tokenHash   String    @map("token_hash")
  status      session_status? @default(active)
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  deviceName  String?   @map("device_name")
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user")
  @@index([tokenHash], map: "idx_user_sessions_hash")
  @@index([expiresAt], map: "idx_user_sessions_expires")
  @@map("user_sessions")
  @@schema("security")
}

model UserDevice {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String    @map("user_id")
  deviceName String?   @map("device_name")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  location   String?
  status     String    @default("active") // active | revoked
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_devices_user")
  @@map("user_devices")
  @@schema("security")
}

model Otp {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?  @map("user_id")
  kind      String
  address   String?
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, address])
  @@index([userId], map: "idx_otps_user")
  @@index([expiresAt], map: "idx_otps_expires")
  @@map("otps")
  @@schema("security")
}

// ═══ user.status ═══════════════════════════════════════════════════

model UserStatusEvent {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String          @map("user_id")
  fromStatus UserStatusKind? @map("from_status")
  toStatus   UserStatusKind  @map("to_status")
  reason     String?
  actor      String          @default("user") // user | admin | system
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_status_events_user")
  @@map("user_status_events")
  @@schema("status")
}

model UserDeletionRequest {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @unique @map("user_id")
  reason      String?
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  finalAt     DateTime  @map("final_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  executedAt  DateTime? @map("executed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([finalAt], map: "idx_user_deletion_pending")
  @@map("user_deletion_requests")
  @@schema("status")
}

model UserDeactivation {
  userId    String    @id @map("user_id")
  reason    String?
  pausedAt  DateTime  @default(now()) @map("paused_at") @db.Timestamptz(6)
  resumedAt DateTime? @map("resumed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_deactivations")
  @@schema("status")
}

model UserRestriction {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String    @map("user_id")
  guideline String
  title     String
  detail    String?
  severity  String    @default("warning") // notice | warning | strike
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeals UserAppeal[]

  @@index([userId], map: "idx_user_restrictions_user")
  @@map("user_restrictions")
  @@schema("status")
}

model UserAppeal {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  restrictionId String    @map("restriction_id")
  userId        String    @map("user_id")
  note          String
  decision      String? // upheld | overturned | pending
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restriction UserRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restrictionId], map: "idx_user_appeals_restriction")
  @@map("user_appeals")
  @@schema("status")
}

// ═══ activity ══════════════════════════════════════════════════════

enum Severity {
  info
  warning
  error
  critical

  @@map("severity")
  @@schema("activity")
}

model ActivityEvent {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  kind      String
  title     String
  detail    String?
  severity  Severity @default(info)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_activity_user")
  @@index([kind], map: "idx_activity_kind")
  @@index([createdAt(sort: Desc)], map: "idx_activity_created")
  @@map("activity_events")
  @@schema("activity")
}

/**
 * One line per "download my data" request.
 *
 * The archive itself is never stored — it is written at the moment it is asked
 * for and handed straight to the browser — so what this table keeps is the
 * *request*: which format the person chose, whether the file was actually
 * produced, and what it was made of at the time. The format lives in a column
 * rather than only in metadata because the download and the history list both
 * have to honour it, and a row whose format is unknown is a JSON download
 * (that is what every request was before the choice existed).
 */
model DataExportRequest {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  /** 'json' | 'html'. Anything unrecognised reads as 'json'. */
  format      String    @default("json")
  /** 'pending' while the file has not been produced, then 'ready' or 'failed'. */
  status      String    @default("pending")
  fileName    String    @map("file_name")
  bytes       Int?
  counts      Json?     @default("{}")
  missing     Json?
  truncated   Json?
  error       String?
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  builtAt     DateTime? @map("built_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)], map: "idx_data_export_requests_user")
  @@index([status], map: "idx_data_export_requests_status")
  @@map("data_export_requests")
  @@schema("activity")
}

model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  icon      String?
  link      String?
  isRead    Boolean? @default(false) @map("is_read")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_notifications_created")
  @@index([isRead], map: "idx_notifications_read")
  @@index([userId], map: "idx_notifications_user")
  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_created")
  @@map("notifications")
  @@schema("user")
}

model UserLogin {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  method    String // password | google | github | magic | passkey
  success   Boolean  @default(true)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  location  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_logins_user")
  @@map("user_logins")
  @@schema("security")
}

// ═══ email ═════════════════════════════════════════════════════════

enum EmailJobKind {
  otp
  verify
  reset
  digest
  notice
  test

  @@map("email_job_kind")
  @@schema("email")
}

model EmailTemplate {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug      String   @unique
  label     String?
  subject   String
  html      String
  variables Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_templates")
  @@schema("email")
}

model email_jobs {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?  @map("user_id")
  dedupeKey   String?  @map("dedupe_key")
  eventKey    String   @default("") @map("event_key")
  toEmail     String   @default("") @map("to_email")
  toAddress   String   @default("") @map("to_address")
  category    String   @default("other")
  priority    String   @default("normal")
  kind        EmailJobKind @default(notice)
  templateSlug String? @map("template_slug")
  subject     String?
  payload     Json     @default("{}")
  status      String   @default("queued")
  contentVersionId String? @map("content_version_id")
  definitionId String? @map("definition_id")
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")
  lastError   String?  @map("last_error")
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey], map: "idx_email_jobs_dedupe")
  @@index([status, availableAt], map: "idx_email_jobs_poll")
  @@index([eventKey, createdAt], map: "idx_email_jobs_event_time")
  @@index([toEmail, createdAt], map: "idx_email_jobs_recipient_time")
  @@index([status, createdAt], map: "idx_email_jobs_status")
  @@index([userId], map: "idx_email_jobs_user")
  @@map("email_jobs")
  @@schema("email")
}

model email_deliveries {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  jobId      String?  @map("job_id")
  userId     String?  @map("user_id")
  toEmail    String   @default("") @map("to_email")
  eventKey   String   @default("") @map("event_key")
  event      String   @default("")
  category   String   @default("other")
  subject    String   @default("")
  status     String   @default("sent")
  provider   String?
  providerId String?  @map("provider_id")
  messageId  String?  @map("message_id")
  contentVersionId String? @map("content_version_id")
  openedAt   DateTime? @map("opened_at") @db.Timestamptz(6)
  clickedAt  DateTime? @map("clicked_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobId], map: "idx_email_deliveries_job")
  @@index([eventKey, createdAt], map: "idx_email_deliveries_event_time")
  @@index([userId, createdAt], map: "idx_email_deliveries_user_time")
  @@index([messageId], map: "idx_email_deliveries_message")
  @@index([status, createdAt], map: "idx_email_deliveries_status")
  @@map("email_deliveries")
  @@schema("email")
}

model email_suppressions {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?  @map("user_id")
  address   String?  @unique
  toEmail   String   @default("") @map("to_email")
  eventKey  String   @default("") @map("event_key")
  reason    String   @default("unsubscribe")
  dedupeKey String?  @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventKey, createdAt], map: "idx_email_suppressions_event")
  @@index([userId, createdAt], map: "idx_email_suppressions_user")
  @@map("email_suppressions")
  @@schema("email")
}

// ═══ app_config ════════════════════════════════════════════════════

model AppConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_config")
  @@schema("ops")
}

// ═══ Restored feature models (from previous schema) ═════════════════

model ApiKey {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  name        String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  permissions Json?     @default("{}")
  isActive    Boolean?  @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([keyHash], map: "idx_api_keys_hash")
  @@index([keyPrefix], map: "idx_api_keys_prefix")
  @@index([userId], map: "idx_api_keys_user")
  @@map("api_keys")
  @@schema("ops")
}

model Blocklist {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String?
  blockedBy  String?   @map("blocked_by")
  isActive   Boolean?  @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users      User?     @relation(fields: [blockedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([targetType, targetId])
  @@index([isActive], map: "idx_blocklist_active")
  @@index([targetType], map: "idx_blocklist_type")
  @@map("blocklist")
  @@schema("security")
}

model CaptchaChallenge {
  id            String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId     String           @map("session_id")
  userId        String?          @map("user_id")
  difficulty    String           @default("easy")
  challengeType String           @default("image")
  question      String
  answerHash    String           @map("answer_hash")
  options       Json?
  imageUrl      String?          @map("image_url")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  attempts      Int              @default(0)
  solved        Boolean          @default(false)
  solvedAt      DateTime?        @map("solved_at") @db.Timestamptz(6)
  ipAddress     String?          @map("ip_address")
  userAgent     String?          @map("user_agent")
  rayId         String           @unique @default(dbgenerated("(gen_random_uuid())::text"))
  attemptLogs   CaptchaAttempt[]

  @@index([sessionId])
  @@index([userId])
  @@index([rayId])
  @@index([difficulty])
  @@map("captcha_challenges")
  @@schema("security")
}

model CaptchaAttempt {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  challengeId String           @map("challenge_id")
  userId      String?          @map("user_id")
  sessionId   String           @map("session_id")
  answer      String
  isCorrect   Boolean          @default(false) @map("is_correct")
  ipAddress   String?          @map("ip_address")
  userAgent   String?          @map("user_agent")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  challenge   CaptchaChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([sessionId])
  @@map("captcha_attempts")
  @@schema("security")
}

model CaptchaBlock {
