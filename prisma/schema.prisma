generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
}

// ═══ The account ═══════════════════════════════════════════════════

enum UserStatusKind {
  active
  restricted
  banned
  suspended
  deactivated
  deletion_pending
  deleted

  @@map("user_status_kind")
}

// The account row holds ONLY identity + lifecycle + timestamps. Every other
// concern has exactly one home: profile → user_profile (+ users.username),
// preferences → user_preferences, contact addresses → user_email/user_phone,
// 2FA & password policy → user_security, OAuth links → user_preferences.misc.oauth,
// enforcement → status + user_restrictions/user_status_events,
// deletion → status + user_deletion_requests.
model User {
  id           String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  username     String?        @unique
  email        String         @unique
  passwordHash String         @default("") @map("password_hash")
  status       UserStatusKind @default(active)
  isAdmin      Boolean        @default(false) @map("is_admin")

  lastActiveAt    DateTime?   @map("last_active_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile         UserProfile?
  preferences     UserPreferences?
  emails          UserEmail[]
  phone           UserPhone?
  security        UserSecurity?
  passkeys        Passkey[]
  sessions        UserSession[]
  devices         UserDevice[]
  statusEvents    UserStatusEvent[]
  deactivation    UserDeactivation?
  deletionRequest UserDeletionRequest?
  restrictions    UserRestriction[]
  appeals         UserAppeal[]
  activityEvents  ActivityEvent[]
  dataExportRequests DataExportRequest[]
  notifications   Notification[]
  logins          UserLogin[]
  emailJobs       email_jobs[]
  otps            Otp[]
  blockedRecords  Blocklist[]
  securityEvents     SecurityEvent[]
  pushSubscriptions  PushSubscription[]
  tipLogs            UserTipLog[]
  tirbeoIdentities   TirbeoIdentity[]

  @@index([status], map: "idx_users_status")
  @@index([createdAt], map: "idx_users_created")
  @@index([lastActiveAt], map: "idx_users_last_active")
  @@map("users")
}

// ═══ user.profile ══════════════════════════════════════════════════

model UserProfile {
  userId     String   @id @map("user_id")
  name       String?
  bio        String?
  gender     String?
  birthday   DateTime? @db.Date
  photoUrl   String?  @map("photo_url")
  bannerUrl  String?  @map("banner_url")
  pronouns   String?
  location   String?
  website    String?
  jobRole    String?  @map("job_role")
  jobCompany String?  @map("job_company")
  jobPlace   String?  @map("job_place")
  jobStarted String?  @map("job_started")
  skills     Json     @default("[]")
  followers  Int      @default(0)
  following  Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

// ═══ user.preferences ══════════════════════════════════════════════

model UserPreferences {
  userId     String   @id @map("user_id")
  appearance Json     @default("{}")
  notif      Json     @default("{}")
  privacy    Json     @default("{}")
  misc       Json     @default("{}")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ═══ user.email ════════════════════════════════════════════════════

model UserEmail {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String    @map("user_id")
  address    String
  kind       String    @default("primary") // primary | secondary | recovery
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId], map: "idx_user_email_user")
  @@map("user_email")
}

model UserPhone {
  userId     String    @id @map("user_id")
  number     String?
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_phone")
}

// ═══ user.security ═════════════════════════════════════════════════

model UserSecurity {
  userId       String   @id @map("user_id")
  totpSecret   String?  @map("totp_secret")
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  backupCodes  Json     @default("[]") @map("backup_codes")
  mustChangePw Boolean  @default(false) @map("must_change_pw")
  saveLoginInfo Boolean @default(true) @map("save_login_info")
  require2FA   Boolean  @default(false) @map("require_2fa")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_security")
}

model Passkey {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String    @map("user_id")
  credentialId   String    @unique @map("credential_id")
  credentialPubkey Bytes   @map("credential_pubkey")
  counter        BigInt    @default(0)
  transports     String?
  deviceName     String?   @map("device_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_passkeys_user")
  @@map("passkeys")
}

model UserSession {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  tokenHash   String    @map("token_hash")
  status      session_status? @default(active)
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  deviceName  String?   @map("device_name")
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user")
  @@index([tokenHash], map: "idx_user_sessions_hash")
  @@index([expiresAt], map: "idx_user_sessions_expires")
  @@map("user_sessions")
}

model UserDevice {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String    @map("user_id")
  deviceName String?   @map("device_name")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  location   String?
  status     String    @default("active") // active | revoked
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_devices_user")
  @@map("user_devices")
}

model Otp {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?  @map("user_id")
  kind      String
  address   String?
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, address])
  @@index([userId], map: "idx_otps_user")
  @@index([expiresAt], map: "idx_otps_expires")
  @@map("otps")
}

// ═══ user.status ═══════════════════════════════════════════════════

model UserStatusEvent {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String          @map("user_id")
  fromStatus UserStatusKind? @map("from_status")
  toStatus   UserStatusKind  @map("to_status")
  reason     String?
  actor      String          @default("user") // user | admin | system
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_status_events_user")
  @@map("user_status_events")
}

model UserDeletionRequest {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @unique @map("user_id")
  reason      String?
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  finalAt     DateTime  @map("final_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  executedAt  DateTime? @map("executed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([finalAt], map: "idx_user_deletion_pending")
  @@map("user_deletion_requests")
}

model UserDeactivation {
  userId    String    @id @map("user_id")
  reason    String?
  pausedAt  DateTime  @default(now()) @map("paused_at") @db.Timestamptz(6)
  resumedAt DateTime? @map("resumed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_deactivations")
}

model UserRestriction {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String    @map("user_id")
  guideline String
  title     String
  detail    String?
  severity  String    @default("warning") // notice | warning | strike
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeals UserAppeal[]

  @@index([userId], map: "idx_user_restrictions_user")
  @@map("user_restrictions")
}

model UserAppeal {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  restrictionId String    @map("restriction_id")
  userId        String    @map("user_id")
  note          String
  decision      String? // upheld | overturned | pending
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restriction UserRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restrictionId], map: "idx_user_appeals_restriction")
  @@map("user_appeals")
}

// ═══ activity ══════════════════════════════════════════════════════

enum Severity {
  info
  warning
  error
  critical

  @@map("severity")
}

model ActivityEvent {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  kind      String
  title     String
  detail    String?
  severity  Severity @default(info)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_activity_user")
  @@index([kind], map: "idx_activity_kind")
  @@index([createdAt(sort: Desc)], map: "idx_activity_created")
  @@map("activity_events")
}

/**
 * One line per "download my data" request.
 *
 * The archive itself is never stored — it is written at the moment it is asked
 * for and handed straight to the browser — so what this table keeps is the
 * *request*: which format the person chose, whether the file was actually
 * produced, and what it was made of at the time. The format lives in a column
 * rather than only in metadata because the download and the history list both
 * have to honour it, and a row whose format is unknown is a JSON download
 * (that is what every request was before the choice existed).
 */
model DataExportRequest {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  /** 'json' | 'html'. Anything unrecognised reads as 'json'. */
  format      String    @default("json")
  /** 'pending' while the file has not been produced, then 'ready' or 'failed'. */
  status      String    @default("pending")
  fileName    String    @map("file_name")
  bytes       Int?
  counts      Json?     @default("{}")
  missing     Json?
  truncated   Json?
  error       String?
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  builtAt     DateTime? @map("built_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)], map: "idx_data_export_requests_user")
  @@index([status], map: "idx_data_export_requests_status")
  @@map("data_export_requests")
}

model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  icon      String?
  link      String?
  isRead    Boolean? @default(false) @map("is_read")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_notifications_created")
  @@index([isRead], map: "idx_notifications_read")
  @@index([userId], map: "idx_notifications_user")
  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_created")
  @@map("notifications")
}

model UserLogin {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  method    String // password | google | github | magic | passkey
  success   Boolean  @default(true)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  location  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_logins_user")
  @@map("user_logins")
}

// ═══ email ═════════════════════════════════════════════════════════

enum EmailJobKind {
  otp
  verify
  reset
  digest
  notice
  test

  @@map("email_job_kind")
}

model EmailTemplate {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug      String   @unique
  label     String?
  subject   String
  html      String
  variables Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_templates")
}

model email_jobs {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?  @map("user_id")
  dedupeKey   String?  @map("dedupe_key")
  eventKey    String   @default("") @map("event_key")
  toEmail     String   @default("") @map("to_email")
  toAddress   String   @default("") @map("to_address")
  category    String   @default("other")
  priority    String   @default("normal")
  kind        EmailJobKind @default(notice)
  templateSlug String? @map("template_slug")
  subject     String?
  payload     Json     @default("{}")
  status      String   @default("queued")
  attempts    Int      @default(0)
  maxAttempts Int      @default(3) @map("max_attempts")
  lastError   String?  @map("last_error")
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey], map: "idx_email_jobs_dedupe")
  @@index([status, availableAt], map: "idx_email_jobs_poll")
  @@index([eventKey, createdAt], map: "idx_email_jobs_event_time")
  @@index([toEmail, createdAt], map: "idx_email_jobs_recipient_time")
  @@index([status, createdAt], map: "idx_email_jobs_status")
  @@index([userId], map: "idx_email_jobs_user")
  @@map("email_jobs")
}

model email_deliveries {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  jobId      String?  @map("job_id")
  userId     String?  @map("user_id")
  toEmail    String   @default("") @map("to_email")
  eventKey   String   @default("") @map("event_key")
  event      String   @default("")
  category   String   @default("other")
  subject    String   @default("")
  status     String   @default("sent")
  provider   String?
  providerId String?  @map("provider_id")
  messageId  String?  @map("message_id")
  openedAt   DateTime? @map("opened_at") @db.Timestamptz(6)
  clickedAt  DateTime? @map("clicked_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobId], map: "idx_email_deliveries_job")
  @@index([eventKey, createdAt], map: "idx_email_deliveries_event_time")
  @@index([userId, createdAt], map: "idx_email_deliveries_user_time")
  @@index([messageId], map: "idx_email_deliveries_message")
  @@index([status, createdAt], map: "idx_email_deliveries_status")
  @@map("email_deliveries")
}


// ═══ app_config ════════════════════════════════════════════════════

model AppConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_config")
}

// ═══ Restored feature models (from previous schema) ═════════════════


model Blocklist {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String?
  blockedBy  String?   @map("blocked_by")
  isActive   Boolean?  @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users      User?     @relation(fields: [blockedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([targetType, targetId])
  @@index([isActive], map: "idx_blocklist_active")
  @@index([targetType], map: "idx_blocklist_type")
  @@map("blocklist")
}






model VerificationLimit {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  method    String   @unique
  max       Int
  windowMs  Int      @map("window_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("verification_limits")
}



enum session_status {
  active
  expired
  revoked
}

model SecurityEvent {
  id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?         @map("user_id")
  eventType String          @map("event_type")
  severity  Severity        @default(info)
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  metadata  Json?           @default("{}")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt], map: "idx_security_events_created")
  @@index([eventType], map: "idx_security_events_type")
  @@index([userId], map: "idx_security_events_user")
  @@index([userId, createdAt(sort: Desc)], map: "idx_security_events_user_created")
  @@index([severity, createdAt(sort: Desc)], map: "idx_security_events_severity_created")
  @@map("security_events")
}


model UserTipLog {
  id     String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId String   @map("user_id")
  tipId  String   @map("tip_id")
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, tipId])
  @@index([userId], map: "idx_tip_logs_user")
  @@map("user_tip_logs")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String   @map("p256dh")
  auth      String   @map("auth")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_push_subscriptions_user")
  @@index([endpoint], map: "idx_push_subscriptions_endpoint")
  @@map("push_subscriptions")
}

model TirbeoIdentity {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String?   @map("user_id")
  username       String    @unique
  email          String?
  verifiedSource String?   @map("verified_source")
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_tirbeo_identities_user")
  @@map("identities")
}

model emailConfig {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  provider         String   @default("resend")
  resendApiKey     String?
  resendDomain     String?  @default("send.tirbeo.com")
  smtpHost         String?
  smtpPort         Int?     @default(587)
  smtpUser         String?
  smtpPass         String?
  defaultFromEmail String   @default("noreply@send.tirbeo.com")
