generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  email String                  @unique
  passwordHash String                  @default("") @map("password_hash")
  name String?
  photoUrl String? @map("photo_url")
  bio String?
  secondaryEmail String? @map("secondary_email")
  phoneNumber String? @map("phone_number")
  phoneVerified Boolean? @map("phone_verified")                @default(false)
  emailVerified Boolean?                @default(false) @map("email_verified")
  username String?                 @unique
  gender String?
  birthday DateTime?               @db.Timestamptz(6)
  googleId String? @map("google_id")                 @unique
  githubId String? @map("github_id")                 @unique
  discordId String? @map("discord_id")                 @unique
  occupation String?
  companyName String? @map("company_name")
  companyRole String? @map("company_role")
  industry String?
  companySize String? @map("company_size")
  website String?
  linkedin String?
  githubUsername String? @map("github_username")
  twitter String?
  country String?
  timezone String?
  language String?                 @default("en")
  theme String?                 @default("system")
  dateFormat String? @map("date_format")                 @default("MM/DD/YYYY")
  timeFormat String? @map("time_format")                 @default("12h")
  fontSize String? @map("font_size")                 @default("default")
  reduceMotion Boolean? @map("reduce_motion")                @default(false)
  highContrast Boolean? @map("high_contrast")                @default(false)
  preferences Json?                   @default("{}")
  totpSecret String?                 @map("totp_secret")
  is2FAEnabled Boolean?                @default(false) @map("is_2fa_enabled")
  isBanned Boolean? @map("is_banned")                @default(false)
  isSuspended Boolean? @map("is_suspended")                @default(false)
  suspendReason String? @map("suspend_reason")
  suspendedUntil DateTime? @map("suspended_until")               @db.Timestamptz(6)
  adminRole String?                 @map("admin_role")
  lastActiveAt DateTime? @map("last_active_at")               @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at")               @db.Timestamptz(6)
  lastLoginIp String? @map("last_login_ip")
  loginCount Int? @map("login_count")                    @default(0)
  karmaPoints Int? @map("karma_points")                    @default(0)
  isVerified Boolean? @map("is_verified")                @default(false)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  activityStreaks activity_streaks?
  apiKeys ApiKey[]
  apiUsageLogs api_usage_logs[]
  auditEvents AuditEvent[]            @relation("AuditActor")
  blocklist Blocklist[]
  contentReports ContentReport[]
  contentReportsReviewed ContentReport[]         @relation("content_reports_reviewed_byTousers")
  emailPreferences email_preferences?
  integrations Integration[]
  invoices invoices[]
  loginHistory login_history[]
  media Media[]
  memberships Membership[]
  notificationPreferences NotificationPreference?
  notifications Notification[]
  otps Otp[]
  passwordResetTokens PasswordResetToken[]
  paymentMethods payment_methods[]
  recoveryCodes RecoveryCode[]
  savedThemes saved_themes[]
  securityEvents SecurityEvent[]
  sessions Session[]
  passkeys Passkey[]
  subscriptions subscriptions[]
  userFeatureFlags user_feature_flags[]
  userPasswords UserPassword[]
  blogPosts Blog[] @relation("BlogAuthor")
  customerTickets Ticket[] @relation("TicketCustomer")
  assignedTickets Ticket[] @relation("TicketAssignee")
  ticketMessages TicketMessage[] @relation("TicketMessageAuthor")
  followers follows[] @relation("FollowsFollower")
  following follows[] @relation("FollowsFollowing")
  profileViewsViewed profile_views[] @relation("ProfileViewViewer")
  profileViews profile_views[] @relation("ProfileViewProfile")
  apps apps[] @relation("AppOwner")
  supportAgents support_agents[] @relation("SupportAgentUser")
  userRolesUserRolesAssignedByIdTousers UserRole[]              @relation("user_roles_assigned_by_idTousers")
  roles UserRole[]
  userSettings user_settings?
  verificationRequestsVerificationRequestsReviewedByTousers verification_requests[] @relation("verification_requests_reviewed_byTousers")
  verificationRequestsVerificationRequestsUserIdTousers verification_requests[] @relation("verification_requests_user_idTousers")
  webhooks webhooks[]
  workspaceInvites workspace_invites[]
  workspaces Workspace[]
  authorizationCodes authorization_codes[]
  accessTokens access_tokens[]
  refreshTokens refresh_tokens[]
  oAuthConsents oAuthConsent[]
  formCollaborators formCollaborator[]
  responseNotes responseNote[]
  forms form[]
  groupMembers GroupMember[]
  supportTickets SupportTicket[]
  supportTicketReplies SupportTicketReply[]
  projects projects[]

  @@index([adminRole], map: "idx_users_admin_role")
  @@index([createdAt], map: "idx_users_created")
  @@index([email], map: "idx_users_email")
  @@index([githubId], map: "idx_users_github_id")
  @@index([googleId], map: "idx_users_google_id")
  @@index([isBanned], map: "idx_users_is_banned")
  @@index([lastActiveAt], map: "idx_users_last_active")
  @@map("users")
}

model UserRole {
  id String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId String    @map("user_id")
  roleId String    @map("role_id")
  assignedById String? @map("assigned_by_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usersUserRolesAssignedByIdTousers User?     @relation("user_roles_assigned_by_idTousers", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role app_roles @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role")
  @@index([userId], map: "idx_user_roles_user")
  @@map("user_roles")
}

model Session {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String          @map("user_id")
  token      String?
  status     session_status? @default(active)
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime?       @map("last_used_at") @db.Timestamptz(6)
  userAgent  String?         @map("user_agent")
  ipAddress  String?         @map("ip_address")
  location   String?
  deviceName String?         @map("device_name")
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz(6)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_sessions_expires")
  @@index([status], map: "idx_sessions_status")
  @@index([token], map: "idx_sessions_token")
  @@index([userId], map: "idx_sessions_user")
  @@map("sessions")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String    @map("user_id")
  code      String
  used      Boolean?  @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code], map: "idx_recovery_codes_code")
  @@index([userId], map: "idx_recovery_codes_user")
  @@map("recovery_codes")
}

model Media {
  id String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  uploadedBy String @map("uploaded_by")
  url String
  filename String?
  mimeType String?  @map("mime_type")
  sizeBytes BigInt? @map("size_bytes")
  width Int?
  height Int?
  duration Float?
  altText String?  @map("alt_text")
  isPublic Boolean? @map("is_public") @default(true)
  metadata Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  user User     @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mimeType], map: "idx_media_mime")
  @@index([isPublic], map: "idx_media_public")
  @@index([uploadedBy], map: "idx_media_uploader")
  @@map("media")
}

model SecurityEvent {
  id String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId String?         @map("user_id")
  eventType String @map("event_type")
  severity severity_level? @default(info)
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  metadata Json?           @default("{}")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt], map: "idx_security_events_created")
  @@index([eventType], map: "idx_security_events_type")
  @@index([userId], map: "idx_security_events_user")
  @@map("security_events")
}

model AuditEvent {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId    String?         @map("actor_id")
  action     String
  targetType String?         @map("target_type")
  targetId   String?         @map("target_id")
  metadata   Json?           @default("{}")
  severity   severity_level? @default(info)
  ipAddress  String?         @map("ip_address")
  userAgent  String?         @map("user_agent")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?           @relation("AuditActor", fields: [actorId], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_audit_events_action")
  @@map("audit_events")
}

model ContentReport {
  id String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  reporterId String         @map("reporter_id")
  targetType String         @map("target_type")
  targetId String         @map("target_id")
  reason String
  description String?
  status report_status? @default(pending)
  reviewedById String? @map("reviewed_by")
  reviewedAt DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  actionTaken String? @map("action_taken")
  notes String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reporter User           @relation(fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy User?          @relation("content_reports_reviewed_byTousers", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reporterId], map: "idx_content_reports_reporter")
  @@index([status], map: "idx_content_reports_status")
  @@index([targetType, targetId], map: "idx_content_reports_target")
  @@map("content_reports")
}

model Notification {
  id String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId String   @map("user_id")
  type String
  title String
  body String?
  icon String?
  link String?
  isRead Boolean? @map("is_read") @default(false)
  metadata Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_notifications_created")
  @@index([isRead], map: "idx_notifications_read")
  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model NotificationPreference {
  id String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId String   @unique @map("user_id")
  type String   @default("all")
  email Boolean? @default(true)
  push Boolean? @default(true)
  inApp Boolean? @map("in_app") @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notification_preferences")
}

model ApiKey {
  id String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId String           @map("user_id")
  name String
  keyHash String           @unique @map("key_hash")
  keyPrefix String @map("key_prefix")
  permissions Json?            @default("{}")
  isActive Boolean? @map("is_active")         @default(true)
  lastUsedAt DateTime?        @map("last_used_at") @db.Timestamptz(6)
  expiresAt DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(6)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  apiUsageLogs api_usage_logs[]

  @@index([keyHash], map: "idx_api_keys_hash")
  @@index([keyPrefix], map: "idx_api_keys_prefix")
  @@index([userId], map: "idx_api_keys_user")
  @@map("api_keys")
}

model Setting {
  id String              @id @default(uuid())
  key String              @unique
  value Json
  type String              @default("string")
  group String              @default("general")
  label String?
  description String?
  isSecret Boolean             @default(false) @map("is_secret")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  settingOverrides setting_overrides[]

  @@index([key])
  @@index([group])
  @@map("settings")
}

model SiteConfig {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  app       String   @unique
  config    Json     @default("{}")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([app], map: "idx_site_configs_app")
  @@map("site_configs")
}

model ThemeConfig {
  id String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name String   @unique
  isActive Boolean? @default(false) @map("is_active")
  isDefault Boolean? @map("is_default") @default(false)
  bgPrimary String? @map("bg_primary")  @default("#08150F")
  bgSecondary String? @map("bg_secondary")  @default("#101c13")
  bgCard String? @map("bg_card")  @default("#12271D")
  bgElevated String? @map("bg_elevated")  @default("#1a3326")
  textPrimary String? @map("text_primary")  @default("#F2EEE8")
  textSecondary String? @map("text_secondary")  @default("#B7C6BE")
  textMuted String? @map("text_muted")  @default("#6b8a7a")
  accentPrimary String? @map("accent_primary")  @default("#569578")
  accentSecondary String? @map("accent_secondary")  @default("#275d46")
  accentHover String? @map("accent_hover")  @default("#6aab8d")
  success String?  @default("#59C173")
  warning String?  @default("#F4B942")
  error String?  @default("#E45D5D")
  borderColor String? @map("border_color")  @default("rgba(255,255,255,0.08)")
  borderHover String? @map("border_hover")  @default("rgba(255,255,255,0.14)")
  borderRadius String? @map("border_radius")  @default("16px")
  fontPrimary String? @map("font_primary")  @default("Inter")
  fontHeading String? @map("font_heading")  @default("Plus Jakarta Sans")
  logoUrl String? @map("logo_url")
  brandName String? @map("brand_name")  @default("Tirbeo")
  brandTagline String? @map("brand_tagline")  @default("Premium Social Platform")
  lightBgPrimary String? @map("light_bg_primary")
  lightBgSecondary String? @map("light_bg_secondary")
  lightTextPrimary String? @map("light_text_primary")
  lightAccentPrimary String? @map("light_accent_primary")
  emailHeaderBg String? @map("email_header_bg")  @default("linear-gradient(135deg,#022B22,#275D46,#569578)")
  emailButtonColor String? @map("email_button_color")  @default("#569578")
  emailTextColor String? @map("email_text_color")  @default("#B7C6BE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_theme_configs_active")
  @@map("theme_configs")
}

model FeatureFlag {
  id String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  key String               @unique
  name String
  description String?
  isActive Boolean? @map("is_active")             @default(false)
  rolloutPct Int? @map("rollout_pct")                 @default(100)
  metadata Json?                @default("{}")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userFeatureFlags user_feature_flags[]
  targets feature_flag_targets[]

  @@index([isActive], map: "idx_feature_flags_active")
  @@index([key], map: "idx_feature_flags_key")
  @@map("feature_flags")
}

model Ticket {
  id String               @id @default(uuid())
  customerId String               @map("customer_id")
  subject String
  description String?
  category String               @default("general")
  priority String               @default("normal")
  status String               @default("open")
  source String               @default("web")
  application String?
  queueId String? @map("queue_id")
  assignedId String? @map("assigned_id")
  slaId String? @map("sla_id")
  closedAt DateTime?            @map("closed_at")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  ticketAssignments ticket_assignments[]
  attachments ticket_attachments[]
  messages TicketMessage[]
  queue support_queues?      @relation(fields: [queueId], references: [id])
  slas slas?                @relation(fields: [slaId], references: [id])
  customer User @relation("TicketCustomer", fields: [customerId], references: [id])
  assigned User? @relation("TicketAssignee", fields: [assignedId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([assignedId])
  @@index([createdAt])
  @@index([priority])
  @@index([queueId])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  content    String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User     @relation("TicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

model Blog {
  id String           @id @default(uuid())
  title String
  slug String           @unique
  excerpt String?
  content String?
  coverImage String? @map("cover_image")
  authorId String           @map("author_id")
  categoryId String? @map("category_id")
  status String           @default("draft")
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  canonicalUrl String? @map("canonical_url")
  viewCount Int              @default(0) @map("view_count")
  publishedAt DateTime?        @map("published_at")
  scheduledAt DateTime? @map("scheduled_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  comments blog_comments[]
  tags blog_tags[]
  versions blog_versions[]
  category blog_categories? @relation(fields: [categoryId], references: [id])
  author User @relation("BlogAuthor", fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("blogs")
}

model Page {
  id String          @id @default(uuid())
  title String
  slug String          @unique
  content String?
  components Json            @default("[]")
  status String          @default("draft")
  layout String          @default("default")
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  isHomePage Boolean         @default(false) @map("is_home_page")
  publishedAt DateTime?       @map("published_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  versions page_versions[]

  @@index([slug])
  @@index([status])
  @@map("pages")
}

model Route {
  id String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  path String
  method String   @default("GET")
  target String?
  description String?
  allowedRoles String[] @map("allowed_roles") @default(["member"])
  internal Boolean? @default(false)
  enabled Boolean? @default(true)
  rateLimit Int? @map("rate_limit")
  cacheTtl Int? @map("cache_ttl")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([path, method])
  @@map("routes")
}

model Blocklist {
  id String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  targetType String @map("target_type")
  targetId String @map("target_id")
  reason String?
  blockedBy String? @map("blocked_by")
  isActive Boolean? @map("is_active")  @default(true)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at")  @default(now()) @db.Timestamptz(6)
  users User?     @relation(fields: [blockedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([targetType, targetId])
  @@index([isActive], map: "idx_blocklist_active")
  @@index([targetType], map: "idx_blocklist_type")
  @@map("blocklist")
}

model ReservedAddress {
  id        String   @id @default(uuid())
  address   String   @unique
  reason    String   @default("reserved")
  level     String   @default("hard")
  category  String   @default("system")
  addedById String?  @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([address])
  @@index([level])
  @@map("reserved_addresses")
}

model Subscriber {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  email     String   @unique
  name      String?
  source    String?  @default("landing")
  status    String?  @default("active")
  tags      Json?    @default("[]")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_subscribers_created")
  @@index([email], map: "idx_subscribers_email")
  @@index([status], map: "idx_subscribers_status")
  @@map("subscribers")
}

model Feedback {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  message   String    @db.Text
  email     String?
  lang      String?
  source    String?   @default("landing")
  status    String?   @default("new")
  metadata  Json?     @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt], map: "idx_feedback_created")
  @@index([email], map: "idx_feedback_email")
  @@index([status], map: "idx_feedback_status")
  @@map("feedback")
}

model achievements {
  id String          @id @default(dbgenerated("(gen_random_uuid())"))
  type AchievementType
  name String
  description String?
  icon String?
  badge String?
  userId String @map("user_id")
  earnedAt DateTime @map("earned_at")        @default(now())

  @@unique([userId, type])
  @@index([type])
