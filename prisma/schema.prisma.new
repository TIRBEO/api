generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                        String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                                                     String                  @unique
  passwordHash                                              String                  @default("") @map("password_hash")
  name                                                      String?
  photoUrl                                                  String?                 @map("photo_url")
  bio                                                       String?
  secondaryEmail                                            String?                 @map("secondary_email")
  phoneNumber                                               String?                 @map("phone_number")
  phoneVerified                                             Boolean?                @default(false) @map("phone_verified")
  emailVerified                                             Boolean?                @default(false) @map("email_verified")
  username                                                  String?                 @unique
  gender                                                    String?
  birthday                                                  DateTime?               @db.Timestamptz(6)
  googleId                                                  String?                 @unique @map("google_id")
  githubId                                                  String?                 @unique @map("github_id")
  discordId                                                 String?                 @unique @map("discord_id")
  occupation                                                String?
  companyName                                               String?                 @map("company_name")
  companyRole                                               String?                 @map("company_role")
  industry                                                  String?
  companySize                                               String?                 @map("company_size")
  website                                                   String?
  linkedin                                                  String?
  githubUsername                                            String?                 @map("github_username")
  twitter                                                   String?
  country                                                   String?
  timezone                                                  String?
  language                                                  String?                 @default("en")
  theme                                                     String?                 @default("system")
  dateFormat                                                String?                 @default("MM/DD/YYYY") @map("date_format")
  timeFormat                                                String?                 @default("12h") @map("time_format")
  fontSize                                                  String?                 @default("default") @map("font_size")
  reduceMotion                                              Boolean?                @default(false) @map("reduce_motion")
  highContrast                                              Boolean?                @default(false) @map("high_contrast")
  preferences                                               Json?                   @default("{}")
  totpSecret                                                String?                 @map("totp_secret")
  is2FAEnabled                                              Boolean?                @default(false) @map("is_2fa_enabled")
  isBanned                                                  Boolean?                @default(false) @map("is_banned")
  isSuspended                                               Boolean?                @default(false) @map("is_suspended")
  suspendReason                                             String?                 @map("suspend_reason")
  suspendedUntil                                            DateTime?               @map("suspended_until") @db.Timestamptz(6)
  adminRole                                                 String?                 @map("admin_role")
  lastActiveAt                                              DateTime?               @map("last_active_at") @db.Timestamptz(6)
  lastLoginAt                                               DateTime?               @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp                                               String?                 @map("last_login_ip")
  loginCount                                                Int?                    @default(0) @map("login_count")
  karmaPoints                                               Int?                    @default(0) @map("karma_points")
  isVerified                                                Boolean?                @default(false) @map("is_verified")
  createdAt                                                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                 DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  activityStreaks                                           activity_streaks?
  apiKeys                                                   ApiKey[]
  apiUsageLogs                                              api_usage_logs[]
  auditEvents                                               AuditEvent[]            @relation("AuditActor")
  blocklist                                                 Blocklist[]
  contentReports                                            ContentReport[]
  contentReportsReviewed                                    ContentReport[]         @relation("content_reports_reviewed_byTousers")
  emailPreferences                                          email_preferences?
  integrations                                              Integration[]
  invoices                                                  invoices[]
  loginHistory                                              login_history[]
  media                                                     Media[]
  memberships                                               Membership[]
  notificationPreferences                                   NotificationPreference?
  notifications                                             Notification[]
  otps                                                      Otp[]
  passwordResetTokens                                       PasswordResetToken[]
  paymentMethods                                            payment_methods[]
  recoveryCodes                                             RecoveryCode[]
  securityEvents                                            SecurityEvent[]
  sessions                                                  Session[]
  passkeys                                                  Passkey[]
  subscriptions                                             subscriptions[]
  userFeatureFlags                                          user_feature_flags[]
  userPasswords                                             UserPassword[]
  blogPosts                                                 Blog[]                  @relation("BlogAuthor")
  customerTickets                                           Ticket[]                @relation("TicketCustomer")
  assignedTickets                                           Ticket[]                @relation("TicketAssignee")
  ticketMessages                                            TicketMessage[]         @relation("TicketMessageAuthor")
  followers                                                 follows[]               @relation("FollowsFollower")
  following                                                 follows[]               @relation("FollowsFollowing")
  profileViewsViewed                                        profile_views[]         @relation("ProfileViewViewer")
  profileViews                                              profile_views[]         @relation("ProfileViewProfile")
  apps                                                      apps[]                  @relation("AppOwner")
  supportAgents                                             support_agents[]        @relation("SupportAgentUser")
  userRolesUserRolesAssignedByIdTousers                     UserRole[]              @relation("user_roles_assigned_by_idTousers")
  roles                                                     UserRole[]
  userSettings                                              user_settings?
  verificationRequestsVerificationRequestsReviewedByTousers verification_requests[] @relation("verification_requests_reviewed_byTousers")
  verificationRequestsVerificationRequestsUserIdTousers     verification_requests[] @relation("verification_requests_user_idTousers")
  webhooks                                                  webhooks[]
  workspaceInvites                                          workspace_invites[]
  workspaces                                                Workspace[]
  authorizationCodes                                        authorization_codes[]
  accessTokens                                              access_tokens[]
  refreshTokens                                             refresh_tokens[]
  oAuthConsents                                             oAuthConsent[]
  formCollaborators                                         formCollaborator[]
  responseNotes                                             responseNote[]
  forms                                                     form[]
  groupMembers                                              GroupMember[]
  projects                                                  projects[]

  @@index([adminRole], map: "idx_users_admin_role")
  @@index([createdAt], map: "idx_users_created")
  @@index([email], map: "idx_users_email")
  @@index([githubId], map: "idx_users_github_id")
  @@index([googleId], map: "idx_users_google_id")
  @@index([isBanned], map: "idx_users_is_banned")
  @@index([lastActiveAt], map: "idx_users_last_active")
  @@map("users")
}

model Session {
  id                       String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                   String          @map("user_id")
  token                    String?
  status                   session_status? @default(active)
  expiresAt                DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime?       @map("last_used_at") @db.Timestamptz(6)
  userAgent                String?         @map("user_agent")
  ipAddress                String?         @map("ip_address")
  location                 String?
  deviceName               String?         @map("device_name")
  revokedAt                DateTime?       @map("revoked_at") @db.Timestamptz(6)
  refreshTokenHash         String?         @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?         @map("previous_refresh_token_hash")
  refreshTokenIssuedAt     DateTime?       @map("refresh_token_issued_at") @db.Timestamptz(6)
  refreshExpiresAt         DateTime?       @map("refresh_expires_at") @db.Timestamptz(6)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_sessions_expires")
  @@index([status], map: "idx_sessions_status")
  @@index([token], map: "idx_sessions_token")
  @@index([userId], map: "idx_sessions_user")
  @@index([refreshTokenHash], map: "idx_sessions_refresh_token")
  @@index([refreshExpiresAt], map: "idx_sessions_refresh_expires")
  @@map("sessions")
}

model UserRole {
  id                                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                            String    @map("user_id")
  roleId                            String    @map("role_id")
  assignedById                      String?   @map("assigned_by_id")
  createdAt                         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usersUserRolesAssignedByIdTousers User?     @relation("user_roles_assigned_by_idTousers", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role                              app_roles @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role")
  @@index([userId], map: "idx_user_roles_user")
  @@map("user_roles")
}

model Otp {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  type      String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int?     @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_otps_expires")
  @@index([type], map: "idx_otps_type")
  @@index([userId], map: "idx_otps_user")
  @@map("otps")
}

model SignupOtp {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int?     @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email], map: "idx_signup_otps_email")
  @@index([expiresAt], map: "idx_signup_otps_expires")
  @@map("signup_otps")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token], map: "idx_password_reset_token")
  @@index([userId], map: "idx_password_reset_user")
  @@map("password_reset_tokens")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String    @map("user_id")
  code      String
  used      Boolean?  @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  users     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code], map: "idx_recovery_codes_code")
  @@index([userId], map: "idx_recovery_codes_user")
  @@map("recovery_codes")
}

model Passkey {
  id                  String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId              String   @map("user_id")
  credentialId        String   @unique @map("credential_id")
  credentialPublicKey Bytes    @map("credential_public_key")
  counter             BigInt   @default(0)
  transports          String?
  deviceName          String?  @map("device_name")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([userId])
  @@map("passkeys")
}

model PasskeyChallenge {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  nonce     String   @unique
  challenge String
  type      String
  userId    String?  @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([nonce])
  @@map("passkey_challenges")
}

model ApiKey {
  id           String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String           @map("user_id")
  name         String
  keyHash      String           @unique @map("key_hash")
  keyPrefix    String           @map("key_prefix")
  permissions  Json?            @default("{}")
  isActive     Boolean?         @default(true) @map("is_active")
  lastUsedAt   DateTime?        @map("last_used_at") @db.Timestamptz(6)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  apiUsageLogs api_usage_logs[]

  @@index([keyHash], map: "idx_api_keys_hash")
  @@index([keyPrefix], map: "idx_api_keys_prefix")
  @@index([userId], map: "idx_api_keys_user")
  @@map("api_keys")
}

model SecurityEvent {
  id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?         @map("user_id")
  eventType String          @map("event_type")
  severity  severity_level? @default(info)
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  metadata  Json?           @default("{}")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt], map: "idx_security_events_created")
  @@index([eventType], map: "idx_security_events_type")
  @@index([userId], map: "idx_security_events_user")
  @@map("security_events")
}

model Ticket {
  id                String               @id @default(uuid())
  customerId        String               @map("customer_id")
  subject           String
  description       String?
  category          String               @default("general")
  priority          String               @default("normal")
  status            String               @default("open")
  source            String               @default("web")
  application       String?
  queueId           String?              @map("queue_id")
  assignedId        String?              @map("assigned_id")
  slaId             String?              @map("sla_id")
  closedAt          DateTime?            @map("closed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  ticketAssignments ticket_assignments[]
  attachments       ticket_attachments[]
  messages          TicketMessage[]
  queue             support_queues?      @relation(fields: [queueId], references: [id])
  slas              slas?                @relation(fields: [slaId], references: [id])
  customer          User                 @relation("TicketCustomer", fields: [customerId], references: [id])
  assigned          User?                @relation("TicketAssignee", fields: [assignedId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([assignedId])
  @@index([createdAt])
  @@index([priority])
  @@index([queueId])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  content    String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User     @relation("TicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}

model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  icon      String?
  link      String?
  isRead    Boolean? @default(false) @map("is_read")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_notifications_created")
  @@index([isRead], map: "idx_notifications_read")
  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @unique @map("user_id")
  type      String   @default("all")
  email     Boolean? @default(true)
  push      Boolean? @default(true)
  inApp     Boolean? @default(true) @map("in_app")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notification_preferences")
}

model AuditEvent {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId    String?         @map("actor_id")
  action     String
  targetType String?         @map("target_type")
  targetId   String?         @map("target_id")
  metadata   Json?           @default("{}")
  severity   severity_level? @default(info)
  ipAddress  String?         @map("ip_address")
  userAgent  String?         @map("user_agent")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?           @relation("AuditActor", fields: [actorId], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_audit_events_action")
  @@map("audit_events")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  type        String   @default("string")
  group       String   @default("general")
  label       String?
  description String?
  isSecret    Boolean  @default(false) @map("is_secret")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([group])
  @@map("settings")
}

model SiteConfig {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  app       String   @unique
  config    Json     @default("{}")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([app], map: "idx_site_configs_app")
  @@map("site_configs")
}

model ThemeConfig {
  id                 String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name               String   @unique
  isActive           Boolean? @default(false) @map("is_active")
  isDefault          Boolean? @default(false) @map("is_default")
  bgPrimary          String?  @default("#08150F") @map("bg_primary")
  bgSecondary        String?  @default("#101c13") @map("bg_secondary")
  bgCard             String?  @default("#12271D") @map("bg_card")
  bgElevated         String?  @default("#1a3326") @map("bg_elevated")
  textPrimary        String?  @default("#F2EEE8") @map("text_primary")
  textSecondary      String?  @default("#B7C6BE") @map("text_secondary")
  textMuted          String?  @default("#6b8a7a") @map("text_muted")
  accentPrimary      String?  @default("#569578") @map("accent_primary")
  accentSecondary    String?  @default("#275d46") @map("accent_secondary")
  accentHover        String?  @default("#6aab8d") @map("accent_hover")
  success            String?  @default("#59C173")
  warning            String?  @default("#F4B942")
  error              String?  @default("#E45D5D")
  borderColor        String?  @default("rgba(255,255,255,0.08)") @map("border_color")
  borderHover        String?  @default("rgba(255,255,255,0.14)") @map("border_hover")
  borderRadius       String?  @default("16px") @map("border_radius")
  fontPrimary        String?  @default("Inter") @map("font_primary")
  fontHeading        String?  @default("Plus Jakarta Sans") @map("font_heading")
  logoUrl            String?  @map("logo_url")
  brandName          String?  @default("Tirbeo") @map("brand_name")
  brandTagline       String?  @default("Premium Social Platform") @map("brand_tagline")
  lightBgPrimary     String?  @map("light_bg_primary")
  lightBgSecondary   String?  @map("light_bg_secondary")
  lightTextPrimary   String?  @map("light_text_primary")
  lightAccentPrimary String?  @map("light_accent_primary")
  emailHeaderBg      String?  @default("linear-gradient(135deg,#022B22,#275D46,#569578)") @map("email_header_bg")
  emailButtonColor   String?  @default("#569578") @map("email_button_color")
  emailTextColor     String?  @default("#B7C6BE") @map("email_text_color")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_theme_configs_active")
  @@map("theme_configs")
}

model Media {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  uploadedBy String   @map("uploaded_by")
  url        String
  filename   String?
  mimeType   String?  @map("mime_type")
  sizeBytes  BigInt?  @map("size_bytes")
  width      Int?
  height     Int?
  duration   Float?
  altText    String?  @map("alt_text")
  isPublic   Boolean? @default(true) @map("is_public")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([mimeType], map: "idx_media_mime")
  @@index([isPublic], map: "idx_media_public")
  @@index([uploadedBy], map: "idx_media_uploader")
  @@map("media")
}

model Blocklist {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  reason     String?
  blockedBy  String?   @map("blocked_by")
  isActive   Boolean?  @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users      User?     @relation(fields: [blockedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([targetType, targetId])
  @@index([isActive], map: "idx_blocklist_active")
  @@index([targetType], map: "idx_blocklist_type")
  @@map("blocklist")
}

model ReservedAddress {
  id        String   @id @default(uuid())
  address   String   @unique
  reason    String   @default("reserved")
  level     String   @default("hard")
  category  String   @default("system")
  addedById String?  @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([address])
  @@index([level])
  @@map("reserved_addresses")
}

model FeatureFlag {
  id               String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  key              String                 @unique
  name             String
  description      String?
  isActive         Boolean?               @default(false) @map("is_active")
  rolloutPct       Int?                   @default(100) @map("rollout_pct")
  metadata         Json?                  @default("{}")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userFeatureFlags user_feature_flags[]
  targets          feature_flag_targets[]

  @@index([isActive], map: "idx_feature_flags_active")
  @@index([key], map: "idx_feature_flags_key")
  @@map("feature_flags")
}

model Blog {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  excerpt        String?
  content        String?
  coverImage     String?          @map("cover_image")
  authorId       String           @map("author_id")
  categoryId     String?          @map("category_id")
  status         String           @default("draft")
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  canonicalUrl   String?          @map("canonical_url")
  viewCount      Int              @default(0) @map("view_count")
  publishedAt    DateTime?        @map("published_at")
  scheduledAt    DateTime?        @map("scheduled_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  comments       blog_comments[]
  tags           blog_tags[]
  versions       blog_versions[]
  category       blog_categories? @relation(fields: [categoryId], references: [id])
  author         User             @relation("BlogAuthor", fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("blogs")
}

model Page {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  content        String?
  components     Json            @default("[]")
  status         String          @default("draft")
  layout         String          @default("default")
  seoTitle       String?         @map("seo_title")
  seoDescription String?         @map("seo_description")
  isHomePage     Boolean         @default(false) @map("is_home_page")
  publishedAt    DateTime?       @map("published_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  versions       page_versions[]

  @@index([slug])
  @@index([status])
  @@map("pages")
}

model Subscriber {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  email     String   @unique
  name      String?
  source    String?  @default("landing")
  status    String?  @default("active")
  tags      Json?    @default("[]")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_subscribers_created")
  @@index([email], map: "idx_subscribers_email")
  @@index([status], map: "idx_subscribers_status")
  @@map("subscribers")
}

model Feedback {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  message   String   @db.Text
  email     String?
  lang      String?
  source    String?  @default("landing")
  status    String?  @default("new")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt], map: "idx_feedback_created")
  @@index([email], map: "idx_feedback_email")
  @@index([status], map: "idx_feedback_status")
  @@map("feedback")
}

model Integration {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String    @map("user_id")
  provider     String
  connected    Boolean?  @default(false)
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  metadata     Json?     @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, provider])
  @@index([userId], map: "idx_integrations_user")
  @@map("integrations")
}

model CaptchaSettings {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  key         String   @unique
  value       Json
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("captcha_settings")
}

model CaptchaChallenge {
  id            String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId     String           @map("session_id")
  userId        String?          @map("user_id")
  difficulty    String           @default("easy") // easy, medium, hard
  challengeType String           @default("image") // image, math, word
  question      String
  answerHash    String           @map("answer_hash")
  options       Json? // For multiple choice
  imageUrl      String?          @map("image_url")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  attempts      Int              @default(0)
  solved        Boolean          @default(false)
  solvedAt      DateTime?        @map("solved_at") @db.Timestamptz(6)
  ipAddress     String?          @map("ip_address")
  userAgent     String?          @map("user_agent")
  rayId         String           @unique @default(dbgenerated("(gen_random_uuid())::text"))
  attemptLogs   CaptchaAttempt[]

  @@index([sessionId])
  @@index([userId])
  @@index([rayId])
  @@index([difficulty])
  @@map("captcha_challenges")
}

model CaptchaAttempt {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  challengeId String   @map("challenge_id")
  userId      String?  @map("user_id")
  sessionId   String   @map("session_id")
  answer      String
  isCorrect   Boolean  @default(false) @map("is_correct")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge CaptchaChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([userId])
  @@index([sessionId])
  @@map("captcha_attempts")
}

model CaptchaBlock {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?   @map("user_id")
  sessionId   String    @map("session_id")
  ipAddress   String    @map("ip_address")
  reason      String // "too_many_attempts", "suspicious_activity", "rate_limit"
  difficulty  String    @default("hard")
  blockedAt   DateTime  @default(now()) @map("blocked_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  unblockedAt DateTime? @map("unblocked_at") @db.Timestamptz(6)
  unblockedBy String?   @map("unblocked_by")
  rayId       String    @unique @default(dbgenerated("(gen_random_uuid())::text"))
  metadata    Json? // Additional context

  @@index([userId])
  @@index([sessionId])
  @@index([ipAddress])
  @@index([rayId])
  @@map("captcha_blocks")
}

model CaptchaLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String?  @map("user_id")
  sessionId  String   @map("session_id")
  ipAddress  String   @map("ip_address")
  eventType  String   @map("event_type") // "challenge_shown", "attempt_failed", "blocked", "unblocked", "settings_changed"
  difficulty String?
  rayId      String?  @map("ray_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([sessionId])
  @@index([ipAddress])
  @@index([eventType])
  @@index([rayId])
  @@map("captcha_logs")
}

model ContentReport {
  id           String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  reporterId   String         @map("reporter_id")
  targetType   String         @map("target_type")
  targetId     String         @map("target_id")
  reason       String
  description  String?
  status       report_status? @default(pending)
  reviewedById String?        @map("reviewed_by")
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  actionTaken  String?        @map("action_taken")
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reporter     User           @relation(fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy   User?          @relation("content_reports_reviewed_byTousers", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reporterId], map: "idx_content_reports_reporter")
  @@index([status], map: "idx_content_reports_status")
  @@index([targetType, targetId], map: "idx_content_reports_target")
  @@map("content_reports")
}

model activity_streaks {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId          String    @unique @map("user_id")
  currentStreak   Int?      @default(0) @map("current_streak")
  longestStreak   Int?      @default(0) @map("longest_streak")
  lastActiveDate  DateTime? @map("last_active_date") @db.Timestamptz(6)
  totalActiveDays Int?      @default(0) @map("total_active_days")
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model api_usage_logs {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String?  @map("user_id")
  apiKeyId   String?  @map("api_key_id")
  endpoint   String
  method     String
  statusCode Int      @map("status_code")
  duration   Int?
  ip         String?
  userAgent  String?  @map("user_agent")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  apiKeys    ApiKey?  @relation(fields: [apiKeyId], references: [id], onUpdate: NoAction)
  users      User?    @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([apiKeyId], map: "idx_api_usage_apikey")
  @@index([createdAt], map: "idx_api_usage_created")
  @@index([endpoint], map: "idx_api_usage_endpoint")
  @@index([userId], map: "idx_api_usage_user")
}

model authorization_codes {
  id                  String            @id @default(dbgenerated("(gen_random_uuid())"))
  clientId            String            @map("client_id")
  userId              String            @map("user_id")
  code                String            @unique
  redirectUri         String            @map("redirect_uri")
  scopes              Json
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(6)
  usedAt              DateTime?         @map("used_at") @db.Timestamptz(6)
  codeChallenge       String?           @map("code_challenge")
  codeChallengeMethod String?           @map("code_challenge_method")
  createdAt           DateTime          @default(now()) @map("created_at")
  app                 app_oauth_clients @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([code])
}

model access_tokens {
  id        String            @id @default(dbgenerated("(gen_random_uuid())"))
  clientId  String            @map("client_id")
  userId    String            @map("user_id")
  token     String            @unique
  scopes    Json
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at")
  app       app_oauth_clients @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([token])
}

model refresh_tokens {
  id        String            @id @default(dbgenerated("(gen_random_uuid())"))
  clientId  String            @map("client_id")
  userId    String            @map("user_id")
  token     String            @unique
  scopes    Json
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at")
  app       app_oauth_clients @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([token])
}

model oAuthConsent {
  id        String            @id @default(dbgenerated("(gen_random_uuid())"))
  clientId  String            @map("client_id")
  userId    String            @map("user_id")
  scopes    Json
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  app       app_oauth_clients @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

model app_roles {
  id          String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String     @unique
  description String?
  color       String?    @default("#4f7aff")
  icon        String?    @default("shield")
  isSystem    Boolean?   @default(false) @map("is_system")
  permissions Json?      @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  userRoles   UserRole[]

  @@index([name], map: "idx_app_roles_name")
}

model apps {
  id           String              @id @default(dbgenerated("(gen_random_uuid())"))
  name         String
  slug         String              @unique
  description  String?
  icon         String?
  url          String?
  status       String              @default("active")
  isPublic     Boolean             @default(true) @map("is_public")
  ownerId      String              @map("owner_id")
  version      String              @default("1.0.0")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  oauthClients app_oauth_clients[]
  permissions  app_permissions[]
  owner        User                @relation("AppOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([slug])
}

model blog_categories {
  id          String   @id @default(dbgenerated("(gen_random_uuid())"))
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  blogs       Blog[]

  @@index([slug])
}

model blog_comments {
  id                String          @id @default(dbgenerated("(gen_random_uuid())"))
  blogId            String          @map("blog_id")
  authorId          String          @map("author_id")
  content           String
  parentId          String?         @map("parent_id")
  status            String          @default("approved")
  createdAt         DateTime        @default(now()) @map("created_at")
  blogs             Blog            @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogComments      blog_comments?  @relation("blog_commentsToblog_comments", fields: [parentId], references: [id])
  otherBlogComments blog_comments[] @relation("blog_commentsToblog_comments")

  @@index([authorId])
  @@index([blogId])
}

model blog_tags {
  id     String @id @default(dbgenerated("(gen_random_uuid())"))
  name   String
  blogId String @map("blog_id")
  blogs  Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, name])
}

model blog_versions {
  id        String   @id @default(dbgenerated("(gen_random_uuid())"))
  blogId    String   @map("blog_id")
  title     String
  content   String?
  version   Int
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  blogs     Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, version])
  @@index([blogId])
}

model comments {
  id            String     @id @default(dbgenerated("(gen_random_uuid())"))
  content       String
  authorId      String     @map("author_id")
  entityType    String     @map("entity_type")
  entityId      String     @map("entity_id")
  parentId      String?    @map("parent_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  projectId     String?
  comments      comments?  @relation("commentsTocomments", fields: [parentId], references: [id], onDelete: Cascade)
  otherComments comments[] @relation("commentsTocomments")
  projects      projects?  @relation(fields: [projectId], references: [id])
  likes         likes[]

  @@index([authorId])
  @@index([entityType, entityId])
  @@index([parentId])
}

model email_preferences {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id")
  securityAlerts    Boolean  @default(true) @map("security_alerts")
  billingReminders  Boolean  @default(true) @map("billing_reminders")
  productUpdates    Boolean  @default(true) @map("product_updates")
  newFeatures       Boolean  @default(false) @map("new_features")
  monthlyNewsletter Boolean  @default(true) @map("monthly_newsletter")
  tipsAndTricks     Boolean  @default(false) @map("tips_and_tricks")
  digestFrequency   String   @default("never") @map("digest_frequency")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  users             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model feature_flag_targets {
  id          String      @id @default(dbgenerated("(gen_random_uuid())"))
  flagId      String      @map("flag_id")
  targetType  String      @map("target_type")
  targetId    String?     @map("target_id")
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  featureFlag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
  @@index([targetType, targetId])
}

model follows {
  id          String   @id @default(dbgenerated("(gen_random_uuid())"))
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("FollowsFollower", fields: [followerId], references: [id])
  following   User     @relation("FollowsFollowing", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([createdAt])
  @@index([followerId])
  @@index([followingId])
}

model invoices {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id")
  subscriptionId  String?        @map("subscription_id") @db.Uuid
  stripeInvoiceId String?        @map("stripe_invoice_id")
  invoiceNumber   String         @map("invoice_number")
  amount          Int
  currency        String         @default("usd")
  status          String         @default("pending")
  description     String?
  periodStart     DateTime?      @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime?      @map("period_end") @db.Timestamptz(6)
  paidAt          DateTime?      @map("paid_at") @db.Timestamptz(6)
  invoicePdf      String?        @map("invoice_pdf")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  subscriptions   subscriptions? @relation(fields: [subscriptionId], references: [id], onUpdate: NoAction)
  users           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_invoices_created_at")
  @@index([status], map: "idx_invoices_status")
  @@index([userId], map: "idx_invoices_user_id")
}

model login_history {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  deviceName    String?  @map("device_name")
  browser       String?
  os            String?
  location      String?
  country       String?
  status        String   @default("successful")
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_login_history_created_at")
  @@index([status], map: "idx_login_history_status")
  @@index([userId], map: "idx_login_history_user_id")
}

model Log {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  ip        String?
  method    String
  path      String
  userId    String?  @map("user_id")
  status    Int?
  duration  Int?
  size      Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_logs_created")
  @@index([ip], map: "idx_logs_ip")
  @@index([path], map: "idx_logs_path")
  @@index([userId], map: "idx_logs_user")
  @@map("logs")
}

model Membership {
  id          String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String          @map("user_id")
  workspaceId String          @map("workspace_id")
  role        workspace_role? @default(MEMBER)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  users       User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, workspaceId])
  @@index([workspaceId], map: "idx_memberships_workspace")
  @@map("memberships")
}

model page_versions {
  id         String   @id @default(dbgenerated("(gen_random_uuid())"))
  pageId     String   @map("page_id")
  title      String
  content    String?
  components Json     @default("[]")
  version    Int
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  pages      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId])
}

model payment_methods {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id")
  stripePaymentMethodId String?  @map("stripe_payment_method_id")
  brand                 String
  lastFour              String   @map("last_four")
  expMonth              Int      @map("exp_month")
  expYear               Int      @map("exp_year")
  isDefault             Boolean  @default(false) @map("is_default")
  billingDetails        Json?    @default("{}") @map("billing_details")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users                 User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_payment_methods_user_id")
}

model profile_views {
  id        String   @id @default(dbgenerated("(gen_random_uuid())"))
  viewerId  String?  @map("viewer_id")
  profileId String   @map("profile_id")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  viewer    User?    @relation("ProfileViewViewer", fields: [viewerId], references: [id])
  profile   User     @relation("ProfileViewProfile", fields: [profileId], references: [id])

  @@index([createdAt])
  @@index([profileId, createdAt])
  @@index([viewerId])
}

model projects {
  id           String         @id @default(dbgenerated("(gen_random_uuid())"))
  title        String
  description  String?
  content      String?
  githubUrl    String?        @map("github_url")
  demoUrl      String?        @map("demo_url")
  language     String?
  category     String         @default("other")
  visibility   String         @default("public")
  isStartup    Boolean        @default(false) @map("is_startup")
  pinned       Boolean        @default(false)
  starCount    Int            @default(0) @map("star_count")
  forkCount    Int            @default(0) @map("fork_count")
  viewCount    Int            @default(0) @map("view_count")
  thumbnailUrl String?        @map("thumbnail_url")
  userId       String         @map("user_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  bookmarks    bookmarks[]
  comments     comments[]
  likes        likes[]
  projectTags  project_tags[]
  user         User           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([category])
  @@index([userId])
  @@index([visibility])
}

model slas {
  id               String           @id @default(dbgenerated("(gen_random_uuid())"))
  name             String           @unique
  firstResponse    Int              @default(3600) @map("first_response")
  resolutionTime   Int              @default(86400) @map("resolution_time")
  escalationTime   Int?             @map("escalation_time")
  priority         String           @default("normal")
  workingHoursOnly Boolean          @default(true) @map("working_hours_only")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @map("updated_at")
  supportQueues    support_queues[]
  tickets          Ticket[]
}

model subscriptions {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String     @map("user_id")
  plan                 String     @default("free")
  status               String     @default("active")
  billingCycle         String     @default("monthly") @map("billing_cycle")
  currentPeriodStart   DateTime   @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime   @default(dbgenerated("(now() + '1 mon'::interval)")) @map("current_period_end") @db.Timestamptz(6)
  canceledAt           DateTime?  @map("canceled_at") @db.Timestamptz(6)
  trialEnd             DateTime?  @map("trial_end") @db.Timestamptz(6)
  stripeSubscriptionId String?    @map("stripe_subscription_id")
  stripeCustomerId     String?    @map("stripe_customer_id")
  metadata             Json?      @default("{}")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  invoices             invoices[]
  users                User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plan], map: "idx_subscriptions_plan")
  @@index([status], map: "idx_subscriptions_status")
  @@index([userId], map: "idx_subscriptions_user_id")
}

model support_agents {
  id         String         @id @default(dbgenerated("(gen_random_uuid())"))
  userId     String         @map("user_id")
  queueId    String         @map("queue_id")
  role       String         @default("agent")
  isActive   Boolean        @default(true) @map("is_active")
  maxTickets Int            @default(10) @map("max_tickets")
  createdAt  DateTime       @default(now()) @map("created_at")
  queue      support_queues @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user       User           @relation("SupportAgentUser", fields: [userId], references: [id])

  @@unique([userId, queueId])
  @@index([userId])
}

model support_queues {
  id           String           @id @default(dbgenerated("(gen_random_uuid())"))
  name         String           @unique
  slug         String           @unique
  description  String?
  managerId    String?          @map("manager_id")
  autoAssign   Boolean          @default(true) @map("auto_assign")
  slaId        String?          @map("sla_id")
  workingHours Json             @default("{}") @map("working_hours")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  agents       support_agents[]
  slas         slas?            @relation(fields: [slaId], references: [id])
  tickets      Ticket[]

  @@index([slug])
}

model ticket_assignments {
  id           String    @id @default(dbgenerated("(gen_random_uuid())"))
  ticketId     String    @map("ticket_id")
  agentId      String    @map("agent_id")
  assignedBy   String    @map("assigned_by")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  tickets      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([ticketId])
}

model ticket_attachments {
  id         String   @id @default(dbgenerated("(gen_random_uuid())"))
  ticketId   String   @map("ticket_id")
  fileName   String   @map("file_name")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  url        String
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  tickets    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model user_feature_flags {
  id           String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String      @map("user_id")
  flagId       String      @map("flag_id")
  isEnabled    Boolean?    @default(true) @map("is_enabled")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  featureFlags FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, flagId])
  @@index([flagId], map: "idx_user_feature_flags_flag")
  @@index([userId], map: "idx_user_feature_flags_user")
}

model UserPassword {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String    @map("user_id")
  label        String    @default("default")
  passwordHash String    @map("password_hash")
  isPrimary    Boolean?  @default(false) @map("is_primary")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_user_passwords_user")
  @@map("user_passwords")
}

model user_settings {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String   @unique @map("user_id")
  emailDigest       String?  @default("daily") @map("email_digest")
  digestTime        String?  @default("08:00") @map("digest_time")
  mentionNotif      Boolean? @default(true) @map("mention_notif")
  commentNotif      Boolean? @default(true) @map("comment_notif")
  reportNotif       Boolean? @default(true) @map("report_notif")
  systemNotif       Boolean? @default(true) @map("system_notif")
  marketingNotif    Boolean? @default(false) @map("marketing_notif")
  pushEnabled       Boolean? @default(true) @map("push_enabled")
  soundEnabled      Boolean? @default(true) @map("sound_enabled")
  profileVisibility String?  @default("public") @map("profile_visibility")
  showOnlineStatus  Boolean? @default(true) @map("show_online_status")
  showLastSeen      Boolean? @default(true) @map("show_last_seen")
  allowMentions     Boolean? @default(true) @map("allow_mentions")
  allowDms          Boolean? @default(true) @map("allow_dms")
  sidebarCollapsed  Boolean? @default(false) @map("sidebar_collapsed")
  defaultPage       String?  @default("/dashboard") @map("default_page")
  compactMode       Boolean? @default(false) @map("compact_mode")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  users             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model verification_requests {
  id                                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                                     String    @map("user_id")
  status                                     String    @default("pending")
  fullName                                   String    @map("full_name")
  description                                String?
  documentUrls                               Json?     @default("[]") @map("document_urls")
  notes                                      String?
  reason                                     String?   @map("reason")
  referredBy                                 String?   @map("referred_by")
  requestedRole                              String?   @default("admin") @map("requested_role")
  reviewedBy                                 String?   @map("reviewed_by")
  reviewedAt                                 DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason                            String?   @map("rejection_reason")
  submittedAt                                DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt                                  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  usersVerificationRequestsReviewedByTousers User?     @relation("verification_requests_reviewed_byTousers", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersVerificationRequestsUserIdTousers     User      @relation("verification_requests_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_verification_requests_status")
  @@index([userId], map: "idx_verification_requests_user_id")
}

model webhooks {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId          String    @map("user_id")
  name            String
  url             String
  secret          String
  events          Json?     @default("[]")
  isActive        Boolean?  @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz(6)
  failCount       Int?      @default(0) @map("fail_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  users           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([isActive], map: "idx_webhooks_active")
  @@index([userId], map: "idx_webhooks_user")
}

model workspace_invites {
  id          String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  workspaceId String          @map("workspace_id")
  email       String
  role        workspace_role? @default(MEMBER)
  invitedById String          @map("invited_by_id")
  token       String          @unique
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime?       @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User            @relation(fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaces  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_workspace_invites_email")
  @@index([token], map: "idx_workspace_invites_token")
  @@index([workspaceId], map: "idx_workspace_invites_workspace")
}

model Workspace {
  id               String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  slug             String              @unique
  description      String?
  ownerId          String              @map("owner_id")
  isPublic         Boolean?            @default(false) @map("is_public")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  memberships      Membership[]
  workspaceInvites workspace_invites[]
  users            User                @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ownerId], map: "idx_workspaces_owner")
  @@index([slug], map: "idx_workspaces_slug")
  @@map("workspaces")
}

model form {
  id                     String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  title                  String
  description            String?
  ownerId                String
  publicId               String             @unique
  status                 String             @default("draft")
  viewCount              Int                @default(0)
  responseCount          Int                @default(0)
  lastSubmissionAt       DateTime?          @db.Timestamptz(6)
  submissionCountToday   Int                @default(0)
  publishedAt            DateTime?          @db.Timestamptz(6)
  thankYouMessage        String?            @default("Thank you for your response!")
  allowCollaboratorEdits Boolean            @default(false)
  captchaEnabled         Boolean            @default(false)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  fields                 formField[]
  pages                  formPage[]
  collaborators          formCollaborator[]
  versions               formVersion[]
  notifications          formNotification?
  responses              response[]
  user                   User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([publicId])
  @@index([status])
  @@map("forms")
}

model formCollaborator {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  formId    String
  userId    String
  role      String   @default("editor")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  form      form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
  @@index([formId])
  @@index([userId])
  @@map("form_collaborators")
}

model response {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  formId          String
  respondentEmail String?
  respondentName  String?
  ipAddress       String?
  userAgent       String?
  status          String           @default("completed")
  completedAt     DateTime?        @db.Timestamptz(6)
  duration        Int?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  answers         responseAnswer[]
  notes           responseNote[]
  form            form             @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([status])
  @@map("responses")
}

model responseNote {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  responseId String
  userId     String
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  response   response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([userId])
  @@map("response_notes")
}

model Group {
  id          String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String        @unique
  description String?
  slug        String        @unique
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")
  members     GroupMember[]

  @@index([slug])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  role     String?  @default("member")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
  @@map("group_members")
}