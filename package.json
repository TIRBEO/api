{
  "name": "@tirbeo/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS=--no-deprecation npx tsx --env-file=.env.local server.ts",
    "build": "prisma generate && next build",
    "start": "node server.js",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "tsx scripts/seedRoutes.ts",
    "seed:defaults": "tsx scripts/seed-defaults.ts",
    "seed:org-rbac": "tsx scripts/seed-org-rbac.ts",
    "seed:flows": "tsx scripts/seed-flows.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "@simplewebauthn/server": "^13.3.2",
    "@tirbeo/types": "^0.0.7",
    "@tirbeo/ui": "^1.0.5",
    "@vercel/analytics": "^2.0.1",
    "argon2": "0.45.1",
    "date-fns": "4.4.0",
    "ioredis": "6.0.0",
    "jose": "6.2.6",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "date-fns": "4.4.0",
    "prisma": "7.9.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=20"
  }
}
