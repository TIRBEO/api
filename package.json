{
  "name": "@tirbeo/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS='--no-deprecation --dns-result-order=ipv4first' npx tsx --env-file=.env.local server.ts",
    "build": "npm run check:emails && prisma generate && next build --webpack",
    "check:emails": "tsx scripts/check-email-templates.ts",
    "start": "node server.js",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "scratch:up": "node scripts/scratch-db.mjs up",
    "scratch:down": "node scripts/scratch-db.mjs down",
    "scratch:env": "node scripts/scratch-env.mjs",
    "scratch:example": "node scripts/scratch-env.mjs --example",
    "scratch:push": "TIRBEO_ENV_FILE=.env.scratch prisma db push",
    "scratch:seed": "tsx --env-file=.env.scratch scripts/scratch-fixture.ts",
    "scratch:setup": "npm run scratch:up && npm run scratch:env && npm run scratch:push && npm run scratch:seed",
    "scratch:dev": "NODE_ENV=development NEXT_DIST_DIR=.next-scratch PORT=3100 WS_PORT=3101 NODE_OPTIONS='--no-deprecation --dns-result-order=ipv4first' tsx --env-file=.env.scratch server.ts",
    "seed:defaults": "tsx scripts/seed-defaults.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vite dev",
    "build:vinext": "vite build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "0.45.1",
    "date-fns": "4.4.0",
    "ioredis": "6.0.0",
    "jose": "6.2.6",
    "next": "16.4.2",
    "nodemailer": "^10.0.16",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.4",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "26.1.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.12",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "@cloudflare/vite-plugin": "1.66.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
