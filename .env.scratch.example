# SCRATCH ENVIRONMENT — the shape of .env.scratch, committed so a fresh
# machine knows which keys the scratch build reads. Never fill this in by
# copying values out of .env.local: run `npm run scratch:setup`, which starts
# the throwaway cluster, generates its own signing secrets, moves every
# address to the .test domain that cannot be delivered to, pushes the schema
# and lays down the fixture rows.

# ─── Tirbeo API — Environment ───────────────────────────────────────────
# Supabase PostgreSQL (main database)
DATABASE_URL=postgresql://tirbeo@127.0.0.1:55432/tirbeo_scratch?sslmode=disable
DIRECT_DATABASE_URL=postgresql://tirbeo@127.0.0.1:55432/tirbeo_scratch?sslmode=disable

# Supabase public
# Supabase activity/metadata logging (user_activity table).
# Paste your SERVICE_ROLE key here (server-side writes bypass RLS):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# JWT
JWT_SECRET=set-this-locally-or-run-scripts-scratch-env-mjs
UNSUBSCRIBE_SECRET=set-this-locally-or-run-scripts-scratch-env-mjs
SESSION_SECRET=set-this-locally-or-run-scripts-scratch-env-mjs

# API / App URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost
NEXT_PUBLIC_COOKIE_DOMAIN=
ADMIN_URL=http://localhost:4000

# Redis (Upstash)
REDIS_URL=

# Resend (email)
RESEND_API_KEY=

# Cloudflare R2 (media storage)
S3_API_ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# OAuth — GitHub
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OAuth — Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=

# Turnstile (CAPTCHA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Widget CAPTCHA
CAPTCHA_WIDGET_SITE_KEY=
CAPTCHA_WIDGET_SECRET_KEY=

# Twilio (SMS / phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Realtime SFU
REALTIME_SFU_NAME=TIRBEO
REALTIME_SFU_PP_ID=
REALTIME_SFU_API_TOKEN=

# TURN server
TURN_NAME=Tirbeo
TURN_TOKEN_ID=
API_TOKEN=set-this-locally-or-run-scripts-scratch-env-mjs

# WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:3001
WS_PORT=3001

# Branding
TIRBEO_LOGO_URL=

# Admin
ADMIN_SEED_EMAIL=someone@scratch.tirbeo.test

# NODE
NODE_ENV=development

# ─── Auth & Security ───
OTP_PEPPER=set-this-locally-or-run-scripts-scratch-env-mjs
RECOVERY_PEPPER=set-this-locally-or-run-scripts-scratch-env-mjs
JWT_ISSUER=
ACCOUNTS_URL=http://localhost:3000
SECURITY_LOG_KEY=set-this-locally-or-run-scripts-scratch-env-mjs

# ─── Dashboard & Admin URLs ───
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:4000

# ─── Push Notifications (VAPID) ───

# ─── Turnstile ───
TURNSTILE_SECRET=

# ─── Misc ───
RT_API_TOKEN=set-this-locally-or-run-scripts-scratch-env-mjs
RT_PUBLISH_URL=
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free

# PROD VALUES (restore these when deploying / set them in Vercel instead):
# GOOGLE_REDIRECT_URI="https://api.tirbeo.com/api/auth/google/callback"
# GITHUB_REDIRECT_URI="https://api.tirbeo.com/api/auth/github/callback"
# DISCORD_REDIRECT_URI="https://api.tirbeo.com/api/auth/discord/callback"

VAPID_PUBLIC_KEY=set-this-locally-or-run-scripts-scratch-env-mjs
VAPID_PRIVATE_KEY=set-this-locally-or-run-scripts-scratch-env-mjs
VAPID_SUBJECT=set-this-locally-or-run-scripts-scratch-env-mjs

# Outbound mail identity — three verified domains, one job each:
#   tirbeo.com        the brand's voice — mail a person may forward or answer
#   mails.tirbeo.com  the machines — codes, digests, notices, staff alerts
#   users.tirbeo.com  the accounts — a handle's own mailbox
ADMIN_FROM_EMAIL=someone@scratch.tirbeo.test
EMAIL_FROM_NAME=Tirbeo
# Alerts for the people who run the panel — ops mail, never a reader's inbox.
EMAIL_ALERT_FROM=someone@scratch.tirbeo.test
EMAIL_CODE_FROM=someone@scratch.tirbeo.test
EMAIL_NOTICE_FROM=someone@scratch.tirbeo.test
EMAIL_SECURITY_FROM=someone@scratch.tirbeo.test
EMAIL_SUPPORT_FROM=someone@scratch.tirbeo.test
# Mail about one account's own status — suspended, exported, reactivated.
EMAIL_ACCOUNT_FROM=someone@scratch.tirbeo.test
EMAIL_HELLO_FROM=someone@scratch.tirbeo.test
# Comma-separated list of Resend-VERIFIED sender domains. Any local part on a
# listed domain (or a subdomain of one) sends; anything else falls back rather
# than earning a 403. All three cleared verification (tirbeo.com 18d, the two
# subdomains 22 Oct).
EMAIL_RESEND_DOMAIN=tirbeo.com, users.tirbeo.com, mails.tirbeo.com
SUPPORT_EMAIL=someone@scratch.tirbeo.test
# The one address a written-in support request is mailed to. The console is
# unaffected — it lists tickets by role, so every holder of tickets.answer
# still sees and answers the same row there (see .env.example).
SUPPORT_INBOX_EMAIL=someone@scratch.tirbeo.test
# Shared copy of every security alert to staff, beside the people whose role
# holds the permission — never instead of them (see .env.example).
STAFF_ALERT_EMAIL=someone@scratch.tirbeo.test
# Where a user's support request is mailed. One named person, not every admin:
# the panel is still open to every account holding tickets.answer, so this is
# the ping, not the queue. Comma-separated for a small team. Unset falls back
# to mailing everyone who holds tickets.answer.
# Handle identities (login address, derived mailbox) now live on the subdomain;
# brand mailboxes above stay on the apex.
TIRBEO_MAIL_DOMAIN=users.tirbeo.com

# Logo served from the live website (28KB) — api. still hosts the 1MB original until redeploy

# CDN file storage (CockroachDB Dedicated)
COCKROACH_DATABASE_URL=postgresql://tirbeo@127.0.0.1:55432/tirbeo_scratch?sslmode=disable

# ─── Pusher Channels (server-side publishing) ───
PUSHER_APP_ID_PRIMARY=
PUSHER_KEY_PRIMARY=
PUSHER_SECRET_PRIMARY=
PUSHER_CLUSTER_PRIMARY=
PUSHER_APP_ID_SECONDARY=
PUSHER_KEY_SECONDARY=
PUSHER_SECRET_SECONDARY=
PUSHER_CLUSTER_SECONDARY=
PUSHER_APP_ID_TERTIARY=
PUSHER_KEY_TERTIARY=
PUSHER_SECRET_TERTIARY=
PUSHER_CLUSTER_TERTIARY=
PUSHER_APP_ID_AP2=
PUSHER_KEY_AP2=
PUSHER_SECRET_AP2=
PUSHER_CLUSTER_AP2=
PUSHER_APP_ID_AP4=
PUSHER_KEY_AP4=
PUSHER_SECRET_AP4=
PUSHER_CLUSTER_AP4=

# ─── Pusher Beams (web push) ───
BEAMS_INSTANCE_ID=
BEAMS_PRIMARY_KEY=
# Shared secret for the profile service (apps/myprofile) -> internal/profile
INTERNAL_API_SECRET=set-this-locally-or-run-scripts-scratch-env-mjs

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_TLS_SERVERNAME=
EMAIL_FROM=someone@scratch.tirbeo.test

SUPABASE_ANON_KEY=

